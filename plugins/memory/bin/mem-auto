#!/usr/bin/env bash
# Starts the engine entry of mem-auto with uv; engine/run.py carries the dependency header.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
here="$(cd -P "$(dirname "$src")" && pwd)"
if ! command -v uv >/dev/null 2>&1; then
  echo "mem-auto: uv is not installed (https://docs.astral.sh/uv/)" >&2
  exit 127
fi
exec uv run --quiet --script "$here/../engine/run.py" --bin mem-auto "$@"
