#!/usr/bin/env python3
"""mem-capture: an offline trial of memory capture from one session transcript.

`run` reduces the transcript to an extract (`capture.extract`), gives it with the claims already recorded in the project's
memory to ONE headless session that has no Bash and no hooks, and keeps the candidates that `capture.validate` accepts
in a local JSON file. It writes nothing to the memory store and no hook runs it: it is started by hand.

Usage: mem-capture run --transcript PATH --out FILE [--project DIR] [--since-line N] [--model NAME] [--budget USD]
                       [--claude PATH] [--no-rules] [--keep-work]
"""
from __future__ import annotations

import argparse
import datetime
import json
import math
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "engine"))
import capture  # noqa: E402
import records  # noqa: E402
import synth_pipeline as sp  # noqa: E402

DEFAULT_BUDGET = 0.25   # USD
DEFAULT_MODEL = "haiku"
SESSION_TIMEOUT = 600
MAX_CANDIDATES_BYTES = 1_000_000
MIN_OWNER_LINES = 3
RULES_LIMIT = 30_000
LAPSED_DAYS = 60   # a lapsed unconfirmed transcript memory can still be revived by a new sighting this long
SESSION_VARS = ("CLAUDE_ENV_FILE", "CLAUDE_PLUGIN_ROOT", "CLAUDE_PLUGIN_DATA", "CLAUDE_PROJECT_DIR", "CLAUDE_PID",
                "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN")

BRIEF = """You read the record of one coding session and find what a later session should not have to learn again.

Files in {work}:
- extract-1.txt, extract-2.txt, ...: the session in order, one event per line. Read every one of them before you write. OWNER is the human, OWNER ANSWER the human's answer to a question, AGENT the assistant, REPORT a message from a subagent or another agent (not the human), TOOL lines the assistant's tool calls, TOOL ERROR a call that failed, TOOL OK the same tool succeeding after an error. The bracket and the label at the start of a line are positions, not content.
- recorded.txt: what the memory already holds, one per line. A line starting with m: is a memory of this project, with its handle; a line starting with (general) holds in every project.
- rules.txt: the standing instructions the owner already wrote for the agent.

Write {work}/candidates.json: a JSON list of at most 5 objects, or [] when nothing qualifies. Most sessions hold one or two things worth keeping, many hold none; five is a ceiling, not a target.

Two kinds of thing qualify, and they are not the same:
- A lesson or a pitfall: something that generalises beyond this session and can be said as advice.
- A decision of this project with its reason. That is a record of the project, not a lesson: give it "kind": "decision" and "reach": "project".
A technical detail of one component, a progress report, or a request the owner made once is neither: leave it out.

Each object has these keys:
- "signal": what in the session backs it. One of
  "owner_correction" (the owner corrected the agent or rejected its approach; the evidence must come from an OWNER line),
  "failed_then_passed" (a check or command failed, the agent changed something, it passed),
  "verified_review_finding" (a review found a defect that was then confirmed and fixed),
  "plan_changed_by_review" (a pre-mortem, a review or the owner changed a plan or a design before it was built),
  "delegation_failed" (a subagent returned no report, stopped at a limit, misread its brief, or its report proved wrong),
  "rework" (work declared done had to be redone or fixed right after),
  "repeated_tool_error" (the same kind of tool error happened more than once),
  "decision_with_reason" (the owner decided something and said why; the evidence must come from an OWNER or OWNER ANSWER line).
  Without one of these there is no candidate: an idea the agent had about itself, with nothing outside confirming it, is not kept.
- "kind": "lesson" (how to work), "pitfall" (something that breaks or misleads), or "decision".
- "reach": "project" when it is about this codebase, its tools or its rules; "general" when it is about how the agent itself works in any project: how it plans, frames a request, briefs or checks a subagent, uses a skill or a plugin, verifies before claiming, or reads the owner's intent. Look for the general ones on purpose: a slip in method teaches more than the bug it caused. A general claim names no file, project or person.
- "weight": how much following it restricts the agent or the owner, and what it costs if it is wrong: "light" (a cheap habit that can hardly hurt), "medium", or "strong" (it forbids something, or a mistake would be costly).
- "form": "suggestion" (worth trying) or "recommendation" (do this unless there is a reason not to). Never an order.
- "claim": 20 to 300 characters, in English, standing on its own in six months. Say what was seen and what it suggests, at the strength the evidence gives it and no more. This session is one sighting: write "in one session ...", "when X, Y happened, so consider ...", not "always" or "never". Say what is not known: whether it holds elsewhere, whether it may be temporary, under which condition it was seen. When the signal is a correction by the owner, report it as what the owner said and did, and weigh the other reading too: the owner may have misread the agent, and then the lesson is to explain more clearly.
- "context": one sentence on when it applies.
- "evidence": a passage copied character for character from inside one line of an extract file, without the bracket and label, 15 to 300 characters, that shows the signal. A paraphrase, or a passage that spans two lines, is rejected by a program.
- "same_as": only when a line of recorded.txt starting with m: already says this: its handle, exactly as written (for example "m:some-handle"). Then this session is one more sighting of it; still give the other keys.

Leave out: what a (general) line of recorded.txt or rules.txt already says; what the code, the git history or the project's documents already state; secrets, tokens, names of people or clients.
"""


def budget_arg(value: str) -> float:
    try:
        number = float(value)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number: {value!r}") from None
    if not math.isfinite(number) or number <= 0:
        raise argparse.ArgumentTypeError(f"must be a positive number: {value!r}")
    return number


def repo_above(folder: Path) -> Path | None:
    """The nearest folder, `folder` or an ancestor, that holds an entry named `.git`."""
    for p in (folder, *folder.parents):
        if os.path.lexists(p / ".git"):
            return p
    return None


def private_dirs(folder: Path) -> None:
    """`folder` and the parents it lacks, mode 0700 (`mkdir(parents=True)` gives the parents the default mode)."""
    missing = []
    for p in (folder, *folder.parents):
        if p.exists():
            break
        missing.append(p)
    for p in reversed(missing):
        p.mkdir(mode=0o700, exist_ok=True)


def write_private(path: Path, text: str) -> None:
    """Never follows a symlink at `path`; the mode is set on the descriptor before anything is written."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        os.fchmod(f.fileno(), 0o600)
        f.write(text)


def _one_line(text: str) -> str:
    return " ".join(text.split())


def recorded_lines(project: Path) -> tuple[list[str], dict[str, str]]:
    """The lines of recorded.txt, and the claims of the project's memories by handle ("m:<handle>").

    Project: live memories, and unconfirmed transcript memories lapsed for at most LAPSED_DAYS (a new sighting
    revives them); a line is `m:<handle>\t<claim>`. Global: live ones as `(general)\t<claim>`, with no handle,
    because a sighting may only be added to a memory of this project."""
    today = datetime.date.today()
    lines: list[str] = []
    handles: dict[str, str] = {}
    for m in records.load_memories(records.project_dir(project), "project"):
        claim = _one_line(m.claim)
        lapsed = (m.status == "active" and m.origin == "transcript" and records.standing(m) == "unconfirmed"
                  and m.valid_until is not None and today - datetime.timedelta(days=LAPSED_DAYS) <= m.valid_until < today)
        if claim and (records.is_live(m, today) or lapsed):
            lines.append(f"m:{m.handle}\t{claim}")
            handles[f"m:{m.handle}"] = claim
    for m in records.load_memories(records.memories_root(os.environ, None), "global"):
        if records.is_live(m, today) and m.claim:
            lines.append(f"(general)\t{_one_line(m.claim)}")
    return lines, handles


def rules_text(project: Path) -> tuple[str, bool]:
    """The owner's always-loaded instruction files, each under `## <name>`, the project's first, each cut to
    RULES_LIMIT characters; and whether any was cut."""
    config = os.environ.get("CLAUDE_CONFIG_DIR")
    config_dir = Path(config).expanduser() if config else Path.home() / ".claude"
    parts: list[str] = []
    cut = False
    for path in (project / "CLAUDE.md", project / "AGENTS.md", config_dir / "CLAUDE.md"):
        try:
            if path.is_file():
                with path.open(encoding="utf-8", errors="replace") as f:
                    text = f.read(RULES_LIMIT + 1)   # never the whole of a huge file
            else:
                text = ""
        except OSError:
            text = ""
        if not text.strip():
            continue
        if len(text) > RULES_LIMIT:
            text, cut = text[:RULES_LIMIT].rstrip("\n") + "\n[...] cut", True
        parts.append(f"## {path.name}\n{text.rstrip(chr(10))}\n")
    return "\n".join(parts), cut


def session_cmd(claude: str, work: Path, brief: str, settings: Path, model: str, max_budget: float) -> list[str]:
    """One session. Tools: Read and Write/Edit inside `work` only (`//` is an absolute path in a permission rule; a new
    file needs the Edit rule beside Write); no Bash, no web, hooks disabled by `settings`."""
    return [claude, "-p", brief, "--model", model, "--effort", "medium", "--settings", str(settings),
            "--setting-sources", "project",
            "--allowedTools", f"Read(/{work}/**)", f"Write(/{work}/**)", f"Edit(/{work}/**)",
            "--disallowedTools", "Bash", "WebSearch", "WebFetch",
            "--output-format", "stream-json", "--verbose", "--no-session-persistence",
            "--max-budget-usd", f"{max_budget:.4f}"]


def run_session(cmd: list[str], work: Path) -> dict:
    env = {k: v for k, v in os.environ.items() if k not in SESSION_VARS}
    try:
        done = subprocess.run(cmd, cwd=work, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                              timeout=SESSION_TIMEOUT)
        raw = done.stdout
    except subprocess.TimeoutExpired as exc:
        raw = exc.stdout.decode() if isinstance(exc.stdout, bytes) else (exc.stdout or "")
    return sp.parse(raw)


def read_candidates(path: Path) -> tuple[object, str | None]:
    if not path.is_file():
        return None, "the session wrote no candidates.json"
    try:
        if path.stat().st_size > MAX_CANDIDATES_BYTES:
            return None, "candidates file too large"
        rows = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None, "candidates.json is not valid JSON"
    return (rows, None) if isinstance(rows, list) else (None, "candidates.json is not a JSON list")


def cmd_run(args: argparse.Namespace) -> int:
    transcript = Path(args.transcript).expanduser()
    given = Path(args.project or ".").expanduser().resolve()
    if args.project is not None and not given.is_dir():
        print(f"mem-capture: --project is not a folder: {given.name}", file=sys.stderr)
        return 2
    # an explicit --project wins over MEM_PROJECT in the caller's environment
    env = os.environ if args.project is None else {k: v for k, v in os.environ.items() if k != "MEM_PROJECT"}
    project = records.project_root(given, env) or given
    model = args.model or DEFAULT_MODEL
    budget = args.budget
    since = max(args.since_line, 0)
    out = {"transcript": transcript.name, "lines": [since + 1, since], "model": model, "cost": None,
           "extract": {"chars": 0, "cut": False, "parts": 0, "skipped": 0, "lines": capture.counts(""),
                       "rules_chars": 0, "rules_cut": False},
           "candidates": [], "dropped": [], "reason": None, "project": project.name}

    out_path = Path(args.out).expanduser()
    repo = repo_above(out_path.parent.resolve())
    if repo is not None:
        print(f"mem-capture: --out is inside a repository ({repo}); the result holds session text", file=sys.stderr)
        return 1
    if out_path.is_symlink():
        print("mem-capture: --out is a symlink; refusing to write through it", file=sys.stderr)
        return 1

    def finish(code: int) -> int:
        try:
            private_dirs(out_path.parent)
            write_private(out_path, json.dumps(out, ensure_ascii=False, indent=1) + "\n")
        except OSError as exc:
            print(f"mem-capture: cannot write {out_path.name}: {exc.strerror or exc}", file=sys.stderr)
            return 1
        if code:
            print(f"mem-capture: {out['reason']}", file=sys.stderr)
        else:
            cost = "unknown" if out["cost"] is None else f"{out['cost']:.3f}"
            print(f"mem-capture: {len(out['candidates'])} kept, {len(out['dropped'])} dropped, "
                  f"lines {out['lines'][0]}-{out['lines'][1]}, cost {cost}")
        return code

    if not transcript.is_file():
        out["reason"] = f"no transcript at {transcript.name}"
        return finish(1)
    text, last = capture.extract(transcript, since)
    out["lines"] = [since + 1, last]
    out["extract"] = {"chars": len(text), "cut": text.startswith(capture.LEFT_OUT_MARKER),
                      "parts": len(capture.parts(text)) if text else 0, "skipped": capture.last_skipped, "lines": capture.counts(text),
                      "rules_chars": 0, "rules_cut": False}
    if out["extract"]["lines"]["OWNER"] < MIN_OWNER_LINES:
        out["reason"] = "too short"
        return finish(0)
    if not args.claude:
        out["reason"] = "no claude binary (--claude, CLAUDE_CODE_EXECPATH or PATH)"
        return finish(1)

    root = Path(tempfile.mkdtemp(prefix="mem-capture-"))   # mode 0700
    try:
        work = root / "work"
        work.mkdir(mode=0o700)
        for number, piece in enumerate(capture.parts(text), 1):
            write_private(work / f"extract-{number}.txt", piece + "\n")
        recorded, handles = recorded_lines(project)
        write_private(work / "recorded.txt", "".join(f"{c}\n" for c in recorded))
        rules, rules_cut = ("", False) if args.no_rules else rules_text(project)
        write_private(work / "rules.txt", rules)
        out["extract"]["rules_chars"], out["extract"]["rules_cut"] = len(rules), rules_cut
        settings = root / "settings.json"
        write_private(settings, json.dumps({"disableAllHooks": True}))   # no hook of the session may run anything
        cmd = session_cmd(args.claude, work, BRIEF.replace("{work}", str(work)), settings, model, budget)
        try:
            done = run_session(cmd, work)
        except OSError as exc:
            out["reason"] = f"cannot start claude ({args.claude}): {exc.strerror or exc}"
            return finish(1)
        out["cost"] = done["cost"] if done["has_result"] else None
        if not done["has_result"]:
            out["reason"] = "the session ended without a cost report"
            return finish(1)
        if done["error"]:
            out["reason"] = "the session failed"
            return finish(1)
        rows, why = read_candidates(work / "candidates.json")
        if why:
            out["reason"] = why
            return finish(1)
        out["candidates"], out["dropped"] = capture.validate(rows, text, [c.split("\t", 1)[1] for c in recorded], handles)
        return finish(0)
    finally:
        if args.keep_work:
            print(f"mem-capture: work folder kept at {root}", file=sys.stderr)
        else:
            shutil.rmtree(root, ignore_errors=True)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("command", choices=["run"])
    parser.add_argument("--transcript", required=True, help="the session transcript (JSONL)")
    parser.add_argument("--out", required=True, help="the result file (mode 0600)")
    parser.add_argument("--project", default=None, help="project folder whose memories are the claims already recorded "
                                                       "(default: the current directory)")
    parser.add_argument("--since-line", type=int, default=0, help="read the transcript after this line")
    parser.add_argument("--model", help=f"model of the session (default {DEFAULT_MODEL})")
    parser.add_argument("--budget", type=budget_arg, default=DEFAULT_BUDGET, help=f"USD for the session (default {DEFAULT_BUDGET})")
    parser.add_argument("--claude", default=os.environ.get("CLAUDE_CODE_EXECPATH") or shutil.which("claude"))
    parser.add_argument("--no-rules", action="store_true", help="leave rules.txt empty (the instruction files are not given)")
    parser.add_argument("--keep-work", action="store_true", help="keep the work folder (it holds session text)")
    return cmd_run(parser.parse_args())


if __name__ == "__main__":
    sys.exit(main())
