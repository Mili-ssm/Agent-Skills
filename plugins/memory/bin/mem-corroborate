#!/usr/bin/env python3
"""mem-corroborate: a background pass that matches lessons by meaning and keeps one general record of each.

`run` collects the active transcript lessons of the registered projects and of the global scope, writes them to a
lessons file (ids only, no project name or path) and starts two tool-less headless sessions: the first proposes
groups of lessons that state the same thing; the second, a fresh process that sees only the proposals, says for each
group whether it is the same lesson, faithfully worded and general. Code validates both answers (`corroborate`) and
applies only the groups that pass, always through `bin/mem` (a secret, a forbidden term or a refused merge is
counted, never forced). The claim of an existing record is never changed.

Undo works on file copies: before a run's first write to a record's file the file is copied to
`runs/<stamp>/before/`, and `journal.jsonl` holds each action, the file, whether the run created it and the hash of
the file afterwards. `undo <stamp>` restores or removes them, and refuses, changing nothing, when a file changed
since. The run folder is private and may hold memory text; `log.jsonl` holds counts only.

`auto` is what a hook starts when the plugin option `auto_capture` is exactly `true`: it never raises and never prints.

Usage: mem-corroborate run [--claude PATH] [--budget USD] [--dry-run --out FILE] [--groups FILE]
       mem-corroborate auto [--claude PATH] | undo STAMP | status | ack | --self-check
       mem-corroborate fill --dry-run --out FILE [--claude PATH] [--budget USD] | fill --items FILE

`fill` proposes the one-line short form and the topic of the lessons that could load as rules at session start but
lack them. Nothing writes a short form unread: `--dry-run --out FILE` only writes the proposal (one session of the
small model); the owner reads and edits FILE, and `--items FILE` applies it through `mem memory edit` (journaled:
`undo STAMP` puts the records back). Each item also carries `load`: `yes` (a rule), `index` (only counted by topic)
or `no` (never loaded); the owner may change it. `seen.json` and the status of the pass are not touched.
"""
from __future__ import annotations

import argparse
import dataclasses
import datetime
import hashlib
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "engine"))
import auto_state as au  # noqa: E402
import capture_state as cs  # noqa: E402

try:   # `auto` must still be able to write a failed status when the engine cannot be imported (e.g. no yaml)
    import corroborate  # noqa: E402
    import records  # noqa: E402
    import rules  # noqa: E402
    import research_pipeline as rp  # noqa: E402
    import shortcheck  # noqa: E402
    import synth_pipeline as sp  # noqa: E402
    IMPORT_ERROR: Exception | None = None
except Exception as _exc:   # noqa: BLE001
    IMPORT_ERROR = _exc

DEFAULT_BUDGET = 0.25   # USD per session
PROPOSE_MODEL = VERIFY_MODEL = "haiku"
CHECK_MODEL = "haiku"   # the second session of the automatic fill; chosen by the gate of 2026-11-22 (the plan's Results)
SESSION_TIMEOUT = 600
MAX_FILE_BYTES = 1_000_000
MEM = HERE / "mem"
MEM_TIMEOUT = 60
SETTLE_STATE = ".settle-state.json"   # beside the global records; `settle.STATE_NAME`
SESSION_VARS = ("CLAUDE_ENV_FILE", "CLAUDE_PLUGIN_ROOT", "CLAUDE_PLUGIN_DATA", "CLAUDE_PROJECT_DIR", "CLAUDE_PID",
                "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN")
SETTLE_VARS = ("MEM_SETTLE_AUTO", "MEM_SETTLE_MINUTES", "MEM_SETTLE_CLAUDE")   # `settle_state.maybe_start` starts a run from these
STAMP_RE = re.compile(r"[A-Za-z0-9._-]+")
ANSWERS = ("same", "faithful", "general")
MAX_RETRIES = 2   # runs that end with a failed action or an unusable answer on the same lessons before the run gives up
REFUSED_MEM_EXITS = {"remember": (4, 5)}   # a `mem merge` refuses with any non-zero exit; any other exit is a failure


class Stop(Exception):
    """A run that cannot go on: `short` is the fixed reason the log line keeps, the message goes to the run's log.txt."""

    def __init__(self, short: str, detail: str):
        super().__init__(detail)
        self.short = short

PROPOSE_BRIEF = """You compare short lessons that coding sessions wrote down, and say which of them state the same lesson.

Read {lessons}. Each line is: an id, a reach (general or project), the lesson, and when it applies, separated by tabs.
Ids starting with g: are lessons already kept for every project; ids starting with p1:, p2: ... belong to one project each.
An id is copied whole, exactly as written, with its g: or p1: start; a line number that your reading tool shows before a line is not an id.

Two lessons are the same when a reader who follows one would do what the other asks, in the same kind of situation,
even if the words, the example or the numbers differ. Lessons about the same topic that advise different things are
not the same. When you are not sure, leave them apart: a wrong group merges two lessons and loses one.

Write {out} as JSON: {{"groups": [{{"ids": ["..."], "claim": "...", "context": "..."}}]}}
- One group for each set of two or more lessons that are the same.
- Also one group for each general lesson with a p id that is in no other group and matches no g: lesson: a group of one.
- Never a group of one for a g: lesson or a project lesson.
- An id appears in at most one group.
- claim: the lesson in one to three sentences, as a suggestion or a recommendation that says what was seen and what
  is not known, never an order. It must hold in any project: name no project, company, client, person, repository,
  file, path, product or internal system. Keep what a reader needs to act: the situation, the action, the reason.
- context: one sentence on when the lesson applies, under the same rule about names.
Write nothing else and use no other tool.
"""

VERIFY_BRIEF = """You check proposals to treat several short lessons as one. Another reader made the proposals; it is often wrong, and
a wrong "yes" merges two different lessons and loses one, so say yes only when you are sure.

Read {groups}. Each block starts with "group <n>", then one line per lesson (an id, the lesson, when it applies,
separated by tabs), then a line starting with "proposed": the single wording that would replace them for every project.

For each group, answer in this order:
- reason: one sentence saying what each lesson asks the reader to do and whether that is the same thing.
- same: true only if a reader who follows any one of the lessons would do what each of the others asks, in the same
  kind of situation. The same topic with different advice is false. For a group of one lesson, write true.
- faithful: true only if the proposed wording keeps the situation, the action and the reason of the lessons, adds no
  claim they do not make, turns no suggestion into an order, and names no project, company, client, person,
  repository, file, path, product or internal system.
- general: true only if the lesson is about how to work (planning, delegating, verifying, using tools, reading what
  was asked) and would hold in another project; false if it only makes sense inside one codebase or product.

Write {out} as JSON: {{"verdicts": [{{"group": 1, "reason": "...", "same": true, "faithful": true, "general": true}}]}}
One entry per group, in order. Write nothing else and use no other tool.
"""

FILL_BRIEF = """You write the short form and the topic of lessons that coding sessions wrote down.
Read {lessons}: one block per lesson, with an id, a claim and sometimes a context.
For each lesson write: short: one sentence of at most 120 characters (aim for 100) that says what may be worth doing and when, as a suggestion, never stronger than the claim. Name the action as a thing or an -ing form ("quoting the source line may catch errors"), not as a command to the reader ("quote the source line"), unless the claim itself is a command. Keep the claim's hedge (may, once, sometimes, untested, provisional); if it is too long, drop alternatives and detail first, never the hedge. It must stand on its own, say "the user" and never "the owner", name no project, person or company, and add nothing the claim does not say. Use the context only to see when it applies. topic: one or two lowercase words for the area (for example: testing, process, shell, review, docs). An id is copied whole.
Write {out} as JSON: {{"items": [{{"id": "g:example", "short": "...", "topic": "..."}}]}}
One item per lesson. Write nothing else and use no other tool.
"""

CHECK_BRIEF = """You check one-sentence short forms of lessons against the lessons they were drawn from. Another writer made them; it sometimes makes a short form stronger or wider than its lesson, and a short form is loaded into every later session, so say faithful only when you are sure.
Read {pairs}: one block per lesson, with an id, a claim, sometimes a context that says when the lesson applies, and a short.
For each block answer in this order:
- reason: one sentence comparing what the claim asks, and when, with what the short asks, and when.
- faithful: true only if the short asks for nothing the claim does not, in no wider a situation, with no more certainty (a "may" or "once" in the claim is still there in the short), as a suggestion and not an order unless the claim is an order (a command addressed to the reader, such as "remove the files" or "confirm it first", is an order even when a "may" stands elsewhere in the sentence), and names no project, person or company. A short that leaves out examples or alternatives is still faithful; one that leaves out the situation the claim is about is not.
Write {out} as JSON: {{"verdicts": [{{"id": "g:example", "reason": "...", "faithful": true}}]}}
One entry per block. Write nothing else and use no other tool.
"""

REWORD_BRIEF = """You rewrite the short form of lessons that coding sessions wrote down. Each short form below was loaded into later sessions and the thing the lesson warns about still happened, so the present wording did not reach its reader.
Read {lessons}: one block per lesson, with an id, a claim, sometimes a context, every wording tried so far with how often the lesson then worked and failed, and what kind of failure followed where it is recorded.
For each lesson write: short: one sentence of at most 120 characters (aim for 100), drawn from the claim and not from the earlier wordings, that differs from all of them. Start with the situation in which it applies, in words a reader in that situation would recognize, then name what may be worth doing as a thing or an -ing form ("quoting the source line may catch errors"), not as a command to the reader, unless the claim itself is a command. It is a suggestion and never stronger than the claim: keep the claim's hedge (may, once, sometimes, untested, provisional); if it is too long, drop alternatives and detail first, never the hedge. It must stand on its own, say "the user" and never "the owner", name no project, person or company, and add nothing the claim does not say. An id is copied whole.
Write {out} as JSON: {{"items": [{{"id": "g:example", "short": "..."}}]}}
One item per lesson. Write nothing else and use no other tool.
"""


# ---- state folder -----------------------------------------------------------------------------------------------

def data_dir() -> Path:
    if os.environ.get("MEM_DATA"):
        return Path(os.environ["MEM_DATA"])
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(state) / "agent-memory"


def corroborate_dir(data: Path) -> Path:
    return Path(data) / "corroborate"


def budget_of(value) -> float:
    try:
        number = float(value)
    except (TypeError, ValueError):
        return DEFAULT_BUDGET
    return number if math.isfinite(number) and number > 0 else DEFAULT_BUDGET


def save_status(cdir: Path, **changes) -> dict:
    au.private_dir(cdir)
    data = {**au.read_json(cdir / au.STATUS_NAME), **changes}
    for key in [k for k, v in data.items() if k == "failure" and v is None]:
        del data[key]
    au.write_json(cdir / au.STATUS_NAME, data)
    return data


def append_log(cdir: Path, line: dict) -> None:
    au.private_dir(cdir)
    fd = os.open(cdir / "log.jsonl", os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as f:
        f.write(json.dumps(line, ensure_ascii=False) + "\n")


def write_private(path: Path, text: str) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8", errors="replace") as f:
        os.fchmod(f.fileno(), 0o600)
        f.write(text)


# ---- the model sessions -----------------------------------------------------------------------------------------

def session_cmd(claude: str, work: Path, brief: str, settings: Path, model: str, max_budget: float) -> list[str]:
    """One session. Only Read and Write exist (`--tools`, no MCP server) and the rules allow them inside `work`
    only; no Bash, no web, hooks disabled by `settings`."""
    return [claude, "-p", brief, "--model", model, "--effort", "medium", "--settings", str(settings),
            "--setting-sources", "project", "--tools", "Read,Write", "--strict-mcp-config",
            "--allowedTools", f"Read(/{work}/**)", f"Write(/{work}/**)", f"Edit(/{work}/**)",
            "--disallowedTools", "Bash", "WebSearch", "WebFetch",
            "--output-format", "stream-json", "--verbose", "--no-session-persistence",
            "--max-budget-usd", f"{max_budget:.4f}"]


def run_session(cmd: list[str], work: Path) -> dict:
    try:
        done = subprocess.run(cmd, cwd=work, env=rp.session_env(), stdin=subprocess.DEVNULL, capture_output=True,
                              text=True, errors="replace", timeout=SESSION_TIMEOUT)
        raw = done.stdout
    except subprocess.TimeoutExpired as exc:
        raw = exc.stdout.decode(errors="replace") if isinstance(exc.stdout, bytes) else (exc.stdout or "")
    return sp.parse(raw)


def read_object(path: Path) -> object:
    """The JSON of `path`, or None when it is missing, too large or not JSON (the validators then say why)."""
    try:
        if not path.is_file() or path.stat().st_size > MAX_FILE_BYTES:
            return None
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


# ---- journal and undo -------------------------------------------------------------------------------------------

def digest(data: bytes | None) -> str | None:
    return hashlib.sha256(data).hexdigest() if data is not None else None


def read_bytes(path: Path) -> bytes | None:
    try:
        return path.read_bytes()
    except OSError:
        return None


class Journal:
    """The undo record of one run: `commit` after an action compares each watched file with its text before."""

    def __init__(self, run: Path):
        self.run = run
        self.seen: dict[str, bool] = {}   # file -> created by this run

    def before_name(self, path: Path) -> str:
        return hashlib.sha1(str(path).encode()).hexdigest()[:16]

    def watch(self, paths) -> dict[Path, bytes | None]:
        """The files and the curation log beside each (an action may log the text it replaces)."""
        out = {Path(p): read_bytes(Path(p)) for p in paths}
        for p in list(out):
            log = p.parent / records.CURATION_LOG
            out.setdefault(log, read_bytes(log))
        return out

    def watch_folder(self, folder: Path) -> dict[Path, bytes | None]:
        found = self.watch(sorted(folder.glob("*.md"))) if folder.is_dir() else {}
        log = folder / records.CURATION_LOG
        found.setdefault(log, read_bytes(log))
        return found

    def commit(self, action: str, before: dict[Path, bytes | None], folder: Path | None = None) -> None:
        """Journal every watched file that changed; with `folder`, files that appeared in it count as created."""
        paths = dict(before)
        if folder is not None and folder.is_dir():
            for p in folder.glob("*.md"):
                paths.setdefault(p, None)
        for path, old in paths.items():
            now = read_bytes(path)
            if now == old:
                continue
            key = str(path)
            if key not in self.seen:
                self.seen[key] = old is None
                if old is not None:
                    folder_b = self.run / "before"
                    au.private_dir(folder_b)
                    write_private_bytes(folder_b / self.before_name(path), old)
            row = {"action": action, "file": key, "created": self.seen[key], "hash": digest(now)}
            fd = os.open(self.run / "journal.jsonl", os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a", encoding="utf-8") as f:
                f.write(json.dumps(row, ensure_ascii=False) + "\n")


def write_private_bytes(path: Path, data: bytes) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as f:
        os.fchmod(f.fileno(), 0o600)
        f.write(data)


def undo_run(run: Path) -> tuple[bool, str]:
    """(done, message). Changes nothing unless every journaled file that is not restored yet still holds what the run
    left in it; a file already equal to its saved copy (or a created one already gone) counts as restored, so an
    interrupted undo can be run again."""
    if (run / "undone").exists():
        return True, f"run {run.name} was already undone"
    journal = run / "journal.jsonl"
    if not journal.is_file():
        return False, "this run has no journal: nothing to undo"
    last: dict[str, dict] = {}
    for text in journal.read_text(encoding="utf-8").splitlines():
        try:
            row = json.loads(text)
        except ValueError:
            return False, "the journal cannot be read: nothing was changed"
        if isinstance(row, dict) and isinstance(row.get("file"), str):
            last[row["file"]] = row
    todo: list[tuple[Path, bytes | None]] = []
    for file, row in last.items():
        path, now = Path(file), read_bytes(Path(file))
        if row.get("created"):
            saved = None
            if now is None:
                continue
        else:
            saved = read_bytes(run / "before" / Journal(run).before_name(path))
            if saved is None:
                return False, f"the saved copy of {file} is missing: nothing was changed"
            if now == saved:
                continue
        if digest(now) != row.get("hash"):
            return False, (f"{file} changed since the run: nothing was changed. Undo the later change first "
                           "(mem restore for a memory), or leave the pass applied")
        todo.append((path, saved))
    for path, saved in todo:
        try:
            if saved is None:
                path.unlink(missing_ok=True)
            else:
                tmp = path.with_name(f".{path.name}.undo")
                write_private_bytes(tmp, saved)
                os.replace(tmp, path)
        except OSError as exc:
            return False, f"cannot restore {path}: {exc.strerror or type(exc).__name__}; run undo again to finish"
    write_private(run / "undone", "")
    return True, f"undone: {len(todo)} files"


def forget_run(cdir: Path, run: Path) -> None:
    """After an undo: the next run does the work again, so drop the saved fingerprint and the marks this run added."""
    seen = au.read_json(cdir / "seen.json")
    if not seen:
        return
    added = au.read_json(run / "seen-added.json").get("marked")
    marks = seen.get("refused")
    seen.pop("fingerprint", None)
    seen.pop("retry", None)
    if isinstance(marks, dict) and isinstance(added, list):
        seen["refused"] = {k: v for k, v in marks.items() if k not in added}
    au.write_json(cdir / "seen.json", seen)


# ---- applying a group -------------------------------------------------------------------------------------------

class Applier:
    """Applies the kept groups through `bin/mem`; the counts of what happened are in `counts`.

    A refusal (exit 4 or 5 of `remember`, a non-zero `merge`) is counted and marked so the group is not tried again.
    Any other result of a `mem` call (an undocumented exit code, a timeout, no process) is a failure: it stops the
    group, marks nothing and keeps the run from saving its fingerprint, so the next run tries again."""

    def __init__(self, journal: Journal, lessons: dict, gfolder: Path | None, cwd: Path, log):
        self.journal, self.lessons, self.gfolder, self.cwd, self.log = journal, lessons, gfolder, cwd, log
        self.counts = {"written": 0, "sightings": 0, "links": 0, "merges": 0, "refused": 0, "failed_actions": 0,
                       "cases": 0}
        self.refused_ids: set[str] = set()
        self.current = None

    def mem(self, args: list[str], project: Path | None = None, stdin: str | None = None, drop_env: tuple = ()):
        env = {k: v for k, v in os.environ.items() if k not in SESSION_VARS and k not in drop_env and k != "MEM_PROJECT"}
        if project is not None:
            env["MEM_PROJECT"] = str(project)
        try:
            done = subprocess.run([str(MEM), *args], env=env, cwd=self.cwd, input=stdin, capture_output=True,
                                  text=True, errors="replace", timeout=MEM_TIMEOUT)
        except (OSError, subprocess.TimeoutExpired) as exc:
            self.log(f"mem {args[0]}: could not run ({type(exc).__name__})")
            return None
        self.log(f"mem {args[0]}: exit {done.returncode} {done.stdout.strip()[:120]!r} {done.stderr.strip()[:200]!r}")
        return done

    def handle(self, lesson_id: str) -> str:
        return f"m:{self.lessons[lesson_id].memory.handle}"

    def add_cases(self, target: str, entries: list[str], cases: list[str]) -> bool:
        """One `mem confirm` per case of the action, for the session's entry; exit 3 (the case is already there) is
        fine, exit 0 counts a case written. False when a call failed."""
        by_session = {records.session_key(e): e for e in reversed(entries)}
        for raw in cases:
            c = records.case(raw)
            entry = by_session.get(c.session) if c else None
            if c is None or entry is None:
                continue
            done = self.mem(["confirm", target, "--global", f"--source={entry}", f"--outcome={c.outcome}",
                             f"--seen-on={c.on.isoformat()}"])
            if done is None or done.returncode not in (0, 3):
                return False
            self.counts["cases"] += done.returncode == 0
        return True

    def sight(self, target: str, entry: str, cases: list[str]):
        """The sighting of `entry`: its first case rides on the first call, so no `seen` entry is logged for it. The
        result of that call, and whether the cases after it went well (None when the call itself did not work)."""
        parsed = [c for c in map(records.case, cases) if c]
        extra = [f"--outcome={parsed[0].outcome}", f"--seen-on={parsed[0].on.isoformat()}"] if parsed else []
        done = self.mem(["confirm", target, "--global", f"--source={entry}", *extra])
        if done is None or done.returncode not in (0, 3):
            return done, None
        if parsed and done.returncode == 0:
            self.counts["cases"] += 1
        return done, self.add_cases(target, [entry], cases[1:] if parsed else cases)

    def path(self, lesson_id: str) -> Path:
        return self.lessons[lesson_id].memory.path

    def apply(self, group, acts) -> bool:
        """Every action of one group, in order; False when one was refused or failed and the rest was left."""
        written: str | None = None   # the global record that this group's write_global made or found
        for a in acts:
            if a.kind in ("merge", "merge_global"):
                args = ["merge"] + (["--global"] if a.kind == "merge_global" else []) + [self.handle(a.keep), self.handle(a.drop)]
                before = self.journal.watch([self.path(a.keep), self.path(a.drop)])
                done = self.mem(args, a.project)
                self.journal.commit(a.kind, before)
                if done is None:
                    return self.fail()
                if done.returncode:
                    return self.refuse()   # left for curation, never forced
                self.counts["merges"] += 1
            elif a.kind == "write_global":
                args = ["remember", "--global", f"--kind={a.record_kind}", f"--claim={a.claim}"]
                if a.context:
                    args.append(f"--context={a.context}")
                args += ["--origin", "transcript", "--reach", "general", "--weight", a.weight]
                args += [f"--source={e}" for e in a.entries] + ["--body-file", "-"]
                # no counts here: the record is not rewritten when a sighting arrives, so a figure would go stale
                body = "Written by the corroboration pass; its sightings are the sessions and projects in `sources`.\n"
                before = self.journal.watch_folder(self.gfolder) if self.gfolder else {}
                done = self.mem(args, stdin=body)
                first = done.stdout.strip().splitlines()[0].split("\t") if done and done.stdout.strip() else []
                cases_ok = True
                if done is not None and done.returncode in (0, 3) and first and first[0].startswith("m:"):
                    cases_ok = self.add_cases(first[0], a.entries, a.cases)
                self.journal.commit("write_global", before, self.gfolder)
                if not cases_ok and done is not None and done.returncode == 0 and first and first[0].startswith("m:"):
                    self.counts["written"] += 1   # the record exists, though a case call failed
                if done is None or not cases_ok:
                    return self.fail()
                if done.returncode == 0 and first and first[0].startswith("m:"):
                    written = first[0]
                    self.counts["written"] += 1
                elif done.returncode == 3 and len(first) == 2 and first[0].startswith("m:"):
                    written = first[0]   # the claim exists: its sightings were added by `remember`
                    self.counts["sightings"] += first[1] == "sighting"
                elif done.returncode in REFUSED_MEM_EXITS["remember"]:
                    return self.refuse()
                else:
                    return self.fail()
            elif a.kind == "sighting":
                target = a.target and f"m:{a.target}" or written
                if not target or not self.gfolder:
                    return self.refuse()
                path = self.gfolder / f"{target[2:]}.md"
                before = self.journal.watch([path])
                done, cases_ok = self.sight(target, a.entry, a.cases)
                self.journal.commit("sighting", before)
                if done is not None and done.returncode == 0:
                    self.counts["sightings"] += 1
                if cases_ok is False:
                    return self.fail()
                if done is None or done.returncode not in (0, 3):
                    return self.fail()
            elif a.kind == "cases":
                if not a.target or not self.gfolder:
                    return self.refuse()
                before = self.journal.watch([self.gfolder / f"{a.target}.md"])
                cases_ok = self.add_cases(f"m:{a.target}", [a.entry], a.cases)
                self.journal.commit("cases", before)
                if not cases_ok:
                    return self.fail()
            elif a.kind == "link":
                target = a.target and f"m:{a.target}" or written
                if not target:
                    return self.refuse()
                before = self.journal.watch([self.path(a.member)])
                done = self.mem(["promote", "--done", self.handle(a.member), "--to", target], a.project)
                self.journal.commit("link", before)
                if done is not None and done.returncode == 0:
                    self.counts["links"] += 1
                else:
                    return self.fail()
        return True

    def refuse(self) -> bool:
        self.counts["refused"] += 1
        self.refused_ids.update(self.current.ids)
        return False

    def fail(self) -> bool:
        self.counts["failed_actions"] += 1
        return False


# ---- the run ----------------------------------------------------------------------------------------------------

def stable_key(lesson) -> str:
    """The name of a lesson that does not change between runs (the ids of a lessons file depend on the registry)."""
    return corroborate.fill_key(lesson.project, lesson.memory.handle)


def planned(acts) -> list[dict]:
    out = []
    for a in acts:
        row = {k: v for k, v in vars(a).items() if v not in (None, [], "")}
        if "project" in row:
            row["project"] = records.project_key(a.project)
        out.append(row)
    return out


def refused_by_verdict(verdict_data: object, n: int) -> bool:
    """True when exactly one verdict names group `n` and its `same` or `general` is present and not `true` (so "yes"
    or `null` counts as a refusal): a verdict that is missing, repeated or lacks both is not. A group refused only
    because its rewording is not `faithful` is not a refusal to remember: the next run rewords it again."""
    items = verdict_data.get("verdicts") if isinstance(verdict_data, dict) else None
    if not isinstance(items, list):
        return False
    found = [v for v in items if isinstance(v, dict) and v.get("group") == n and not isinstance(v.get("group"), bool)]
    return len(found) == 1 and any(k in found[0] and found[0][k] is not True for k in ("same", "general"))


def has_verdict(verdict_data: object, n: int) -> bool:
    items = verdict_data.get("verdicts") if isinstance(verdict_data, dict) else None
    return isinstance(items, list) and any(isinstance(v, dict) and v.get("group") == n
                                           and not isinstance(v.get("group"), bool) for v in items)


def execute(claude: str | None, budget: float, groups_file: str | None = None, dry_run: bool = False,
            out_file: str | None = None) -> dict:
    """One run. The log line (counts only); a dry run writes nothing but `out_file`."""
    start = time.time()
    data = data_dir()
    cdir = corroborate_dir(data)
    line: dict = {"t": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"), "lessons": 0,
                  "groups": 0, "proposed": 0, "verified": 0, "dropped": 0, "written": 0, "sightings": 0, "links": 0,
                  "merges": 0, "refused": 0, "failed_actions": 0, "cases": 0, "skipped": None, "cost": 0.0, "failed": None, "ms": 0}
    lock = None
    logged: list[bool] = []
    run: Path | None = None

    def finish_log() -> None:
        if dry_run:
            return
        line["ms"] = int((time.time() - start) * 1000)
        append_log(cdir, line)
        logged.append(True)

    def log(text: str) -> None:
        if run is None:
            return
        fd = os.open(run / "log.txt", os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8", errors="replace") as f:
            f.write(f"{time.strftime('%H:%M:%S')} {text}\n")

    scratch = Path(tempfile.mkdtemp(prefix="mem-corroborate-")) if dry_run else None
    try:
        if IMPORT_ERROR is not None:
            line["failed"] = "engine import error"
            save_status(cdir, state="failed", finished=time.time(), failure={"at": time.time(), "reason": line["failed"], "log": ""})
            finish_log()
            return line
        if not dry_run:
            lock = au.take_run_lock(cdir)
            if lock is None:
                line["skipped"] = "another run holds the lock"
                finish_log()
                return line
        seen = au.read_json(cdir / "seen.json")
        refused_seen = seen.get("refused") if isinstance(seen.get("refused"), dict) else {}
        try:
            registry = records.read_registry(data)
        except ValueError as exc:
            raise Stop("registry unreadable", f"registry: {exc}") from exc
        gfolder = records.global_memories_root(os.environ)
        today = datetime.date.today()

        def collect() -> list:
            return corroborate.collect(corroborate.counted_projects(registry), gfolder, today)

        lessons = collect()
        before = corroborate.fingerprint(lessons)   # compared with the retry a failed run stored (its lessons after its writes)
        line["lessons"] = len(lessons)
        if not lessons:
            line["skipped"] = "no lessons"
        elif not (groups_file or dry_run) and seen.get("fingerprint") == corroborate.fingerprint(lessons):
            line["skipped"] = "nothing new"
        if line["skipped"]:
            finish_log()
            return line
        if not dry_run:   # only a run that works gets a folder and a status
            run = cdir / "runs" / f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
            au.private_dir(run)
            save_status(cdir, state="running", started=time.time(), finished=None, log=str(run))
        root = run if run is not None else scratch
        by_id = {x.id: x for x in lessons}
        write_private(root / "lessons.txt", "".join(f"{ln}\n" for ln in corroborate.lesson_lines(lessons)))
        verdict_data: object = None
        proposal: object = None
        incomplete = False   # a session left no usable file: nothing is saved, so the next run asks again
        if groups_file:
            proposal = read_object(Path(groups_file).expanduser())
            proposed, reasons = corroborate.validate_groups(proposal, lessons)
            kept, vreasons = list(proposed), []   # a reviewed file: no verifying session
        else:
            if not claude:
                raise Stop("no claude", "no claude binary (--claude, CLAUDE_CODE_EXECPATH or PATH)")
            settings = root / "settings.json"
            write_private(settings, json.dumps({"disableAllHooks": True}))
            work1 = root / "propose"
            work1.mkdir(mode=0o700)
            write_private(work1 / "lessons.txt", (root / "lessons.txt").read_text(encoding="utf-8"))
            out1 = work1 / "groups.json"
            brief = PROPOSE_BRIEF.format(lessons=work1 / "lessons.txt", out=out1)
            done = run_session(session_cmd(claude, work1, brief, settings, PROPOSE_MODEL, budget), work1)
            line["cost"] += done["cost"] if done["has_result"] else 0.0
            log(f"propose: has_result={done['has_result']} error={done['error']} cost={done['cost']:.3f}")
            if not done["has_result"] or done["error"]:
                raise Stop("session error", "the proposing session ended without a cost report" if not done["has_result"]
                           else "the proposing session failed")
            proposal = read_object(out1)
            incomplete = not (isinstance(proposal, dict) and isinstance(proposal.get("groups"), list))
            proposed, reasons = corroborate.validate_groups(proposal, lessons)
            # a refused group waits until one of its lessons changes (a sighting, a new wording): all marks must still hold
            proposed = [g for g in proposed if not all(refused_seen.get(stable_key(by_id[i])) == corroborate.lesson_fingerprint(by_id[i])
                                                       for i in g.ids)]
            kept, vreasons = [], []
            if proposed:
                work2 = root / "verify"
                work2.mkdir(mode=0o700)
                write_private(work2 / "groups.txt", "".join(f"{ln}\n" for ln in corroborate.verification_lines(proposed, by_id)))
                out2 = work2 / "verdicts.json"
                brief = VERIFY_BRIEF.format(groups=work2 / "groups.txt", out=out2)
                done = run_session(session_cmd(claude, work2, brief, settings, VERIFY_MODEL, budget), work2)
                line["cost"] += done["cost"] if done["has_result"] else 0.0
                log(f"verify: has_result={done['has_result']} error={done['error']} cost={done['cost']:.3f}")
                if not done["has_result"] or done["error"]:
                    raise Stop("session error", "the verifying session ended without a cost report" if not done["has_result"]
                               else "the verifying session failed")
                verdict_data = read_object(out2)
                incomplete = incomplete or not (isinstance(verdict_data, dict) and isinstance(verdict_data.get("verdicts"), list))
                kept, vreasons = corroborate.validate_verdicts(verdict_data, proposed)
        raw_groups = proposal.get("groups") if isinstance(proposal, dict) else None
        line["groups"] = len(raw_groups) if isinstance(raw_groups, list) else 0
        line["proposed"], line["verified"], line["dropped"] = len(proposed), len(kept), len(reasons)
        # a proposed group the verifying session did not answer is neither applied nor marked: ask again
        incomplete = incomplete or any(g not in kept and not has_verdict(verdict_data, n)
                                       for n, g in enumerate(proposed, start=1) if not groups_file)
        if incomplete:   # no usable answer from a session counts as dropped, even where the validator says it per group
            line["dropped"] += len(vreasons)
        for why in [*reasons, *vreasons]:
            log(f"not applied: {why}")
        refused_now = {i for n, g in enumerate(proposed, start=1) if g not in kept and refused_by_verdict(verdict_data, n)
                       for i in g.ids}
        if dry_run:
            plan = [{"ids": g.ids, "claim": g.claim, "actions": planned(corroborate.actions(g, by_id))} for g in kept]
            write_private(Path(out_file), json.dumps({"proposal": proposal, "dropped": reasons, "verdicts": verdict_data,
                                                      "not_verified": vreasons, "plan": plan}, ensure_ascii=False, indent=1) + "\n")
            return line
        applier = Applier(Journal(run), by_id, gfolder, run, log)
        failed_ids: set[str] = set()
        for g in kept:
            applier.current = g
            failed_before = applier.counts["failed_actions"]
            try:
                applier.apply(g, corroborate.actions(g, by_id))
            except Exception as exc:   # noqa: BLE001 - one odd group never stops the others
                log(f"group failed: {type(exc).__name__}: {exc}")
                applier.fail()
            if applier.counts["failed_actions"] > failed_before:
                failed_ids.update(g.ids)
        for key in ("written", "sightings", "links", "merges", "refused", "failed_actions", "cases"):
            line[key] = applier.counts[key]
        # marks are the fingerprints the lessons have now, after this run's own writes (a merge changes the kept record)
        after = {stable_key(x): corroborate.lesson_fingerprint(x) for x in collect()}
        marked = {stable_key(by_id[i]) for i in (refused_now | applier.refused_ids) - failed_ids}
        marks = {k: v for k, v in refused_seen.items() if isinstance(v, str) and k in after}
        marks.update({k: after[k] for k in marked if k in after})
        seen_out: dict = {"refused": marks}
        gave_up = False
        if (line["failed_actions"] or incomplete) and not groups_file:
            # no fingerprint, so the next run tries again, but only MAX_RETRIES times on the same lessons
            old = seen.get("retry") if isinstance(seen.get("retry"), dict) else {}
            count = (old.get("count") if old.get("fingerprint") == before and isinstance(old.get("count"), int) else 0) + 1
            now = corroborate.fingerprint(collect())   # after this run's writes: what the next run starts from
            if count >= MAX_RETRIES:
                gave_up = True
                seen_out["fingerprint"] = now
            else:
                seen_out["retry"] = {"fingerprint": now, "count": count}
        elif line["failed_actions"] or incomplete:
            if isinstance(seen.get("retry"), dict):   # a reviewed file starts no session and leaves the bound alone
                seen_out["retry"] = seen["retry"]
        elif not groups_file:   # a reviewed file never tells the model's pass that the lessons were seen
            seen_out["fingerprint"] = corroborate.fingerprint(collect())
        elif "fingerprint" in seen:
            seen_out["fingerprint"] = seen["fingerprint"]
        write_private(run / "seen-added.json", json.dumps({"marked": sorted(marked)}))
        au.write_json(cdir / "seen.json", seen_out)
        if gave_up:
            raise Stop("gave up after repeated failures", f"gave up: {MAX_RETRIES} runs in a row on these lessons ended "
                       "with a failed action or an unusable answer; the run folders hold the details")
        save_done(cdir, line, None, dry_run)
        finish_log()
        return line
    except Exception as exc:   # noqa: BLE001 - a background process reports and ends
        reason = str(exc) if isinstance(exc, Stop) else f"{type(exc).__name__}: {exc}"
        line["failed"] = exc.short if isinstance(exc, Stop) else type(exc).__name__
        if not dry_run:
            try:
                if run is None and lock is not None:   # the details of a failure need a private place
                    run = cdir / "runs" / f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
                    au.private_dir(run)
                log(f"failed: {reason}")
                save_done(cdir, line, line["failed"], dry_run, log=str(run) if run else "")
                if not logged:
                    finish_log()
            except Exception:   # noqa: BLE001
                pass
        else:
            line["failed_reason"] = reason
        return line
    finally:
        if lock is not None and (run is not None or (cdir / "runs").is_dir()):   # a skipped run prunes too
            try:
                cs.prune_runs(cdir / "runs", cs.KEEP_RUNS, cs.KEEP_RUN_DAYS, time.time())
            except Exception:   # noqa: BLE001
                pass
        if lock is not None:
            os.close(lock)
        if scratch is not None:
            shutil.rmtree(scratch, ignore_errors=True)


def save_done(cdir: Path, line: dict, failure: str | None, dry_run: bool, log: str = "") -> None:
    """A failure line stays in the status until `ack`: a later successful run does not clear it."""
    if dry_run:
        return
    now = time.time()
    end: dict = {"state": "failed" if failure else "ok", "finished": now, "cost": line["cost"]}
    if log:
        end["log"] = log
    if failure:
        end["failure"] = {"at": now, "reason": failure[:300], "log": log}
    save_status(cdir, **end)


def summary(line: dict) -> str:
    if line["failed"]:
        return f"mem-corroborate: failed: {line['failed']}"
    if line["skipped"]:
        return f"mem-corroborate: skipped: {line['skipped']}"
    more = f", {line['failed_actions']} failed (tried again next run)" if line["failed_actions"] else ""
    return (f"mem-corroborate: {line['lessons']} lessons, {line['verified']} of {line['proposed']} groups applied: "
            f"{line['written']} written, {line['sightings']} sightings, {line['links']} links, {line['merges']} merges, "
            f"{line['refused']} refused{more}")


def repo_above(folder: Path) -> Path | None:
    """The nearest folder, `folder` or an ancestor, that holds an entry named `.git` (as `mem-capture run --out`)."""
    for p in (folder, *folder.parents):
        if os.path.lexists(p / ".git"):
            return p
    return None


def cmd_run(args) -> int:
    if IMPORT_ERROR is not None:
        print(f"mem-corroborate: cannot load the engine: {IMPORT_ERROR}", file=sys.stderr)
        return 1
    if args.dry_run and not args.out:
        print("mem-corroborate: --dry-run needs --out FILE", file=sys.stderr)
        return 2
    if args.out and not args.dry_run:
        print("mem-corroborate: --out goes with --dry-run", file=sys.stderr)
        return 2
    if args.dry_run and args.groups:
        print("mem-corroborate: --dry-run runs the sessions: it does not take --groups", file=sys.stderr)
        return 2
    if args.dry_run:
        repo = repo_above(Path(args.out).expanduser().resolve().parent)
        if repo is not None:
            print(f"mem-corroborate: --out is inside a repository ({repo}); the result holds memory text", file=sys.stderr)
            return 2
    line = execute(args.claude, args.budget, args.groups, args.dry_run, args.out)
    print(summary(line) if not line.get("failed_reason") else f"mem-corroborate: failed: {line['failed_reason']}")
    return 1 if line["failed"] else 0


# ---- fill: a short form and a topic for the owner to read ---------------------------------------------------------

def _fill_world():
    """(data folder, registry, counted projects, global folder, project name of each path)."""
    data = data_dir()
    registry = records.read_registry(data)
    projects = corroborate.counted_projects(registry)
    names: dict[Path, str] = {}
    for name in sorted(registry):
        entry = registry[name]
        if isinstance(entry, dict) and isinstance(entry.get("path"), str):
            names.setdefault(Path(entry["path"]), name)
    return data, projects, records.global_memories_root(os.environ), names


def fill_dry_run(args) -> int:
    if not args.claude:
        print("mem-corroborate: no claude binary (--claude, CLAUDE_CODE_EXECPATH or PATH)", file=sys.stderr)
        return 1
    folder = Path(args.out).expanduser().resolve().parent
    if not (folder.is_dir() and os.access(folder, os.W_OK | os.X_OK)):
        print(f"mem-corroborate: --out: {folder} is not a folder that can be written", file=sys.stderr)
        return 2
    repo = repo_above(folder)
    if repo is not None:
        print(f"mem-corroborate: --out is inside a repository ({repo}); the result holds memory text", file=sys.stderr)
        return 2
    try:
        _data, projects, gfolder, names = _fill_world()
    except ValueError as exc:
        print(f"mem-corroborate: registry unreadable: {exc}", file=sys.stderr)
        return 1
    candidates = corroborate.fill_candidates(projects, gfolder, datetime.date.today())
    where = {i: p for i, p, _m in corroborate.fill_records(projects, gfolder)}
    by_id = dict(candidates)
    kept: dict[str, dict] = {}
    reasons: list[str] = []
    cost = 0.0
    if candidates:
        scratch = Path(tempfile.mkdtemp(prefix="mem-corroborate-fill-"))
        try:
            settings = scratch / "settings.json"
            write_private(settings, json.dumps({"disableAllHooks": True}))
            work = scratch / "fill"
            work.mkdir(mode=0o700)
            write_private(work / "lessons.txt", corroborate.fill_lines(candidates))
            out = work / "fill.json"
            brief = FILL_BRIEF.format(lessons=work / "lessons.txt", out=out)
            done = run_session(session_cmd(args.claude, work, brief, settings, PROPOSE_MODEL, args.budget), work)
            cost = done["cost"] if done["has_result"] else 0.0
            if not done["has_result"] or done["error"]:
                print("mem-corroborate: the session failed; nothing was written", file=sys.stderr)
                return 1
            kept, reasons = corroborate.validate_fill(read_object(out), list(by_id))
        finally:
            shutil.rmtree(scratch, ignore_errors=True)
    for ident in by_id:
        kept.setdefault(ident, {"short": "", "topic": "", "problem": "no proposal"})
    items = []
    for ident, fields in kept.items():
        m = by_id[ident]
        project = where[ident]
        items.append({"id": ident, "handle": m.handle, "scope": "global" if project is None else names.get(project, str(project)),
                      "claim": m.claim, "short": fields["short"], "topic": fields["topic"],
                      "load": "index" if m.load == "index" else "yes",
                      "claim_digest": corroborate.claim_digest(m), **({"problem": fields["problem"]} if "problem" in fields else {})})
    to_edit = sum("problem" in i for i in items)
    write_private(Path(args.out).expanduser(), json.dumps(items, ensure_ascii=False, indent=1) + "\n")
    print(f"mem-corroborate: fill: {len(candidates)} lessons asked, {len(items) - to_edit} kept, {to_edit} to edit, {len(reasons)} dropped, "
          f"cost {cost:.3f} USD; read {args.out}, edit or cut it, then run fill --items {args.out}")
    for why in reasons:
        print(f"  not kept: {why}", file=sys.stderr)
    return 0


def apply_fill(items: list[dict], run: Path, user_read: bool) -> dict:
    """Writes the items into the records and journals them in `run` (the caller holds the run lock). Returns
    {"written", "dropped", "failed", "applied", "refused"}; `applied` holds the id of each item written and `refused`
    the id of each one `mem memory edit` refused. Without `user_read` (the automatic fill) an item never sets `load`:
    a record turned off is dropped, and a record's load stays as the owner has it."""
    _data, projects, gfolder, names = _fill_world()
    au.private_dir(run)
    write_private(run / "fill", "")   # marks the run: its undo leaves the pass's `seen.json` alone

    def log(text: str) -> None:
        fd = os.open(run / "log.txt", os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        with os.fdopen(fd, "a", encoding="utf-8", errors="replace") as f:
            f.write(f"{time.strftime('%H:%M:%S')} {text}\n")

    known = {i: (p, m) for i, p, m in corroborate.fill_records(projects, gfolder)}
    applier = Applier(Journal(run), {}, gfolder, run, log)
    written = dropped = failed = 0
    applied: list[str] = []
    refused: list[str] = []
    used: set[str] = set()
    today = datetime.date.today()
    for n, item in enumerate(items, start=1):
        ident = item.get("id") if isinstance(item, dict) else None
        short = item.get("short") if isinstance(item, dict) else None
        topic = item.get("topic") if isinstance(item, dict) else None
        load = item.get("load") if isinstance(item, dict) and user_read else None
        why = None
        if not all(isinstance(x, str) for x in (ident, short, topic)):
            why = "not an object with id, short and topic"
        elif ident not in known:
            why = f"unknown id {ident}"
        elif ident in used:
            why = f"repeats {ident}"
        elif not records.valid_short(short):
            why = "short is not one line of at most 120 characters"
        elif not records.valid_topic(topic):
            why = "topic is not one or two lowercase words"
        elif user_read and "load" in item and load not in ("yes", "index", "no"):
            why = "load must be yes, index or no"
        else:
            project, m = known[ident]
            scope = "global" if project is None else names.get(project, str(project))
            if item.get("handle", m.handle) != m.handle or item.get("scope", scope) != scope:
                why = "handle or scope does not match its id"
            elif m.triage == "pending" or not rules.eligible(
                    dataclasses.replace(m, load=None) if m.load == "no" and load is not None else m, today):
                why = "not a lesson that can load"   # a record turned off may be turned on again by an item that names `load`
        if why:
            dropped += 1
            log(f"item {n} dropped: {why}")
            continue
        used.add(ident)
        if item.get("claim_digest") != corroborate.claim_digest(m):
            failed += 1
            log(f"item {n} failed: {ident} changed its claim since the file was made")
            continue
        watched = [m.path] if project is not None else [m.path, m.path.parent / SETTLE_STATE]   # an edit of a global record may update it
        before = applier.journal.watch(watched)
        done = applier.mem(["memory", "edit", f"m:{m.handle}", *(["--global"] if project is None else []),
                            f"--short={short}", *(["--user-read"] if user_read else []), f"--topic={topic}",
                            *{"yes": ["--load"], "index": ["--index-only"], "no": ["--no-load"]}.get(load, [])], project, drop_env=SETTLE_VARS)
        applier.journal.commit("fill", before)
        if done is not None and done.returncode == 0:
            written += 1
            applied.append(ident)
        else:
            failed += 1
            refused.append(ident)
            log(f"item {n} failed: mem refused or could not run for {ident}")
    return {"written": written, "dropped": dropped, "failed": failed, "applied": applied, "refused": refused}


def fill_items(args) -> int:
    path = Path(args.items).expanduser()
    items = read_object(path)
    if not isinstance(items, list):
        print(f"mem-corroborate: {path} is not a JSON list of items", file=sys.stderr)
        return 2
    cdir = corroborate_dir(data_dir())
    lock = au.take_run_lock(cdir)
    if lock is None:
        print("mem-corroborate: a run is going: try again later", file=sys.stderr)
        return 1
    start = time.time()
    try:
        run = cdir / "runs" / f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}-fill"
        result = apply_fill(items, run, user_read=True)
        written, dropped, failed = result["written"], result["dropped"], result["failed"]
        line = {"t": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
                "fill": {"asked": len(items), "written": written, "dropped": dropped, "failed": failed},
                "ms": int((time.time() - start) * 1000)}
        append_log(cdir, line)
        print(f"mem-corroborate: fill: {len(items)} asked, {written} written, {dropped} dropped, {failed} failed; "
              f"undo with: mem-corroborate undo {run.name}")
        return 1 if failed else 0
    except Exception as exc:   # noqa: BLE001
        print(f"mem-corroborate: fill failed: {type(exc).__name__}: {exc}", file=sys.stderr)
        return 1
    finally:
        os.close(lock)


ATTEMPTS_NAME = "fill-attempts.json"
CHECK_REFUSAL = "the checker did not find the short form faithful to the claim"
APPLY_REFUSAL = "mem refused to write the short form"


def _fill_state(cdir: Path) -> dict:
    """The automatic fill's memory, read defensively: a missing or broken file is an empty state."""
    data = au.read_json(cdir / ATTEMPTS_NAME)
    lessons = data.get("lessons")
    failures = data.get("failures")
    lessons = {k: v for k, v in lessons.items() if isinstance(v, dict)} if isinstance(lessons, dict) else {}
    failures = failures if isinstance(failures, dict) else {}
    count = failures.get("count")
    return {"lessons": lessons, "failures": {"count": count if isinstance(count, int) and count > 0 else 0,
                                             "fingerprint": failures.get("fingerprint")}}


def _fill_run_folder(cdir: Path) -> Path:
    """`<stamp>-<pid>-fill`, with a number before `-fill` when a run of this process already took the second."""
    base = f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
    run, n = cdir / "runs" / f"{base}-fill", 1
    while run.exists():
        n += 1
        run = cdir / "runs" / f"{base}-{n}-fill"
    return run


def _ask(claude: str, scratch: Path, name: str, model: str, budget: float, template: str, text: str,
         text_key: str, out_name: str) -> tuple[object, float, bool]:
    """One session in its own folder: (the JSON it wrote or None, its cost, whether it ended with a result and no error)."""
    work = scratch / name
    work.mkdir(mode=0o700)
    write_private(work / "input.txt", text)
    out = work / out_name
    brief = template.format(**{text_key: work / "input.txt"}, out=out)
    try:
        done = run_session(session_cmd(claude, work, brief, scratch / "settings.json", model, budget), work)
    except OSError:   # a binary that is missing or cannot run is a failed session
        return None, 0.0, False
    cost = done["cost"] if done["has_result"] else 0.0
    ok = done["has_result"] and not done["error"]
    return (read_object(out) if ok else None), cost, ok


def fill_auto(claude: str | None, budget: float) -> dict:
    """Writes the short forms of the lessons that lack one, with nobody reading them first: a writer session, the
    code check (`shortcheck`), a second session that checks the survivors against their claims, then `apply_fill`.
    Every doubt ends in not writing. A session with no usable answer is a failed session: no lesson is charged an
    attempt and nothing is applied. The result holds numbers and `stopped` only; the same dict is the saved status."""
    cdir = corroborate_dir(data_dir())
    result = {"asked": 0, "written": 0, "dropped": 0, "refused_code": 0, "refused_check": 0, "to_triage": 0, "left": 0,
              "cost": 0.0, "stopped": None}
    lock = au.take_run_lock(cdir)
    if lock is None:
        return {**result, "stopped": "a run is going"}
    try:
        return _fill_locked(claude, budget, cdir, result)
    finally:
        os.close(lock)


def _fill_locked(claude: str | None, budget: float, cdir: Path, result: dict) -> dict:
    def finish(**changes) -> dict:
        result.update(changes)
        result["cost"] = round(result["cost"], 6)
        save_status(cdir, fill=dict(result))
        return result

    try:
        _data, projects, gfolder, names = _fill_world()
    except ValueError:
        return finish(stopped="the registry is unreadable")
    state = _fill_state(cdir)
    candidates = corroborate.fill_candidates(projects, gfolder, datetime.date.today(), attempts=state["lessons"])
    where = {i: p for i, p, _m in corroborate.fill_records(projects, gfolder)}
    result["asked"] = len(candidates)
    keys = {i: corroborate.fill_key(where[i], m.handle) for i, m in candidates}
    digests = {i: corroborate.claim_digest(m) for i, m in candidates}

    if not candidates:
        return finish()
    fingerprint = hashlib.sha256(json.dumps(sorted((keys[i], digests[i]) for i, _m in candidates)).encode()).hexdigest()
    failures = state["failures"]
    if failures["fingerprint"] != fingerprint:
        failures["count"] = 0

    def save_state() -> None:
        au.write_json(cdir / ATTEMPTS_NAME, state)

    if failures["count"] >= corroborate.FILL_FAILURES:
        return finish(stopped="waiting for the lessons to change", asked=0)
    if not claude:
        return finish(stopped="no claude binary")

    def failed_session(why: str) -> dict:
        failures["count"] += 1
        failures["fingerprint"] = fingerprint
        save_state()
        return finish(stopped=why)

    by_id = dict(candidates)
    scratch = Path(tempfile.mkdtemp(prefix="mem-corroborate-fill-"))
    try:
        write_private(scratch / "settings.json", json.dumps({"disableAllHooks": True}))
        payload, cost, ok = _ask(claude, scratch, "write", PROPOSE_MODEL, budget, FILL_BRIEF,
                                 corroborate.fill_lines(candidates), "lessons", "fill.json")
        result["cost"] += cost
        if not (ok and isinstance(payload, dict) and isinstance(payload.get("items"), list)):
            return failed_session("the writer session gave no usable answer")
        kept, _dropped_reasons = corroborate.validate_fill(payload, list(by_id))
        reason: dict[str, str] = {}      # id -> why the lesson was refused
        passed: list[tuple[str, dict]] = []
        for i in by_id:
            item = kept.get(i)
            if item is None:
                reason[i] = "no proposal"
            elif "problem" in item:
                reason[i] = item["problem"]
            elif found := shortcheck.problems(by_id[i].claim, item["short"]):
                reason[i] = found[0]
            else:
                passed.append((i, item))
        result["refused_code"] = len(reason)   # every refusal before the checker, a missing proposal included
        faithful: dict[str, bool] = {}
        if passed:
            text = corroborate.check_lines([(i, by_id[i].claim, by_id[i].context, item["short"]) for i, item in passed])
            payload, cost, ok = _ask(claude, scratch, "check", CHECK_MODEL, budget, CHECK_BRIEF, text, "pairs",
                                     "verdicts.json")
            result["cost"] += cost
            checked = corroborate.validate_check(payload, [i for i, _x in passed]) if ok else None
            if checked is None:
                return failed_session("the checker session gave no usable answer")
            faithful = checked
    finally:
        shutil.rmtree(scratch, ignore_errors=True)

    items = []
    for i, fields in passed:
        if not faithful[i]:
            reason[i] = CHECK_REFUSAL
            result["refused_check"] += 1
            continue
        m = by_id[i]
        project = where[i]
        items.append({"id": i, "handle": m.handle, "scope": "global" if project is None else names.get(project, str(project)),
                      "claim": m.claim, "short": fields["short"], "topic": fields["topic"], "claim_digest": digests[i]})
    applied: list[str] = []
    apply_failed = False
    if items:
        run = _fill_run_folder(cdir)
        try:
            done = apply_fill(items, run, user_read=False)
        except Exception:   # an apply that raised is an outcome: what reached the records is read back from them
            apply_failed = True
            applied = _written_ids(items)
            for x in items:
                if x["id"] not in applied:
                    reason[x["id"]] = APPLY_REFUSAL
        else:
            applied = done["applied"]
            for i in done["refused"]:
                reason[i] = APPLY_REFUSAL
            write_private(run / "applied.json", json.dumps([by_id[i].handle for i in applied]))
            result["written"], result["dropped"], result["left"] = done["written"], done["dropped"], done["failed"]
    for i in applied:
        state["lessons"][keys[i]] = {"digest": digests[i], "count": corroborate.FILL_ATTEMPTS}
    holds: list[tuple[str, str]] = []
    for i, why in reason.items():
        count = corroborate.attempt_count(state["lessons"].get(keys[i]), digests[i]) + 1
        state["lessons"][keys[i]] = {"digest": digests[i], "count": count}
        if count >= corroborate.FILL_ATTEMPTS:
            holds.append((i, why))
    if apply_failed:
        failures["count"] += 1
        failures["fingerprint"] = fingerprint
    else:
        failures["count"], failures["fingerprint"] = 0, None
    save_state()
    for i, why in holds:
        if where[i] is None and _hold(by_id[i].handle, why, cdir, gfolder):
            result["to_triage"] += 1
        else:
            result["left"] += 1
    return finish(stopped="the apply failed") if apply_failed else finish()


def _written_ids(items: list[dict]) -> list[str]:
    """The ids of the items whose short form is in the records now: what an `apply_fill` that raised had written."""
    try:
        _data, projects, gfolder, _names = _fill_world()
        known = {i: m for i, _p, m in corroborate.fill_records(projects, gfolder)}
    except ValueError:
        return []
    return [x["id"] for x in items if x["id"] in known and known[x["id"]].short == x["short"]
            and known[x["id"]].short_by == "model"]


def _hold(handle: str, why: str, cdir: Path, gfolder: Path | None) -> bool:
    applier = Applier(None, {}, gfolder, cdir, lambda _text: None)
    done = applier.mem(["triage", "hold", f"m:{handle}", "--because", why[:200]], None, drop_env=SETTLE_VARS)
    return done is not None and done.returncode == 0


# ---- reword: a new short form for a loaded lesson that got worse -----------------------------------------------------

REWORD_ATTEMPTS_NAME = "reword-attempts.json"
REWORD_WRITER_OUT = "reword.json"
REWORD_CHECK_OUT = "reword-check.json"


def _reword_state(cdir: Path) -> dict:
    """The step's memory, read defensively: a missing or broken file is an empty state."""
    data = au.read_json(cdir / REWORD_ATTEMPTS_NAME)
    lessons = data.get("lessons")
    failures = data.get("failures")
    lessons = {k: v for k, v in lessons.items() if isinstance(v, dict)} if isinstance(lessons, dict) else {}
    failures = failures if isinstance(failures, dict) else {}
    count = failures.get("count")
    return {"lessons": lessons, "failures": {"count": count if isinstance(count, int) and count > 0 else 0,
                                             "fingerprint": failures.get("fingerprint")}}


def _reword_run_folder(cdir: Path) -> Path:
    base = f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
    run, n = cdir / "runs" / f"{base}-reword", 1
    while run.exists():
        n += 1
        run = cdir / "runs" / f"{base}-{n}-reword"
    return run


def _reword_edit(applier: Applier, project: Path | None, m, *flags: str) -> bool:
    """One `mem memory edit` of the step, journaled; whether `mem` accepted it."""
    watched = [m.path] if project is not None else [m.path, m.path.parent / SETTLE_STATE]   # a global edit may update it
    before = applier.journal.watch(watched)
    done = applier.mem(["memory", "edit", f"m:{m.handle}", *(["--global"] if project is None else []), *flags], project,
                       drop_env=SETTLE_VARS)
    applier.journal.commit("reword", before)
    return done is not None and done.returncode == 0


def _cell(text: object) -> str:
    return " ".join(str(text or "").split()).replace("|", "\\|")


def _reword_sheet(path: Path, rows: list[tuple]) -> None:
    lines = ["| id | claim | present short form | proposed short form | outcome | checker's reason |", "|---|---|---|---|---|---|"]
    lines += ["| " + " | ".join(_cell(x) for x in row) + " |" for row in rows]
    write_private(path, "\n".join(lines) + "\n")


def reword_auto(claude: str | None, budget: float, *, every: bool = False, apply: bool = True,
                sheet: Path | None = None, limit: int = 30) -> dict:
    """Rewrites the short form of loaded lessons that got worse, with nobody reading it first: a writer session, the
    code check, a second session that checks the survivors against their claims, then one `mem memory edit
    --reworded` each. Follows `fill_auto`: every doubt ends in not writing; a session with no usable answer is a
    failed session that charges no lesson. With `apply` false it writes no record and saves no state (the sessions
    still run, and cost). Never raises: a failure is a counted result with `stopped` set."""
    result = {"asked": 0, "written": 0, "refused_code": 0, "refused_check": 0, "same_text": 0, "no_proposal": 0,
              "gave_up": 0, "cost": 0.0, "stopped": None}
    try:
        cdir = corroborate_dir(data_dir())
        lock = au.take_run_lock(cdir)
        if lock is None:
            return {**result, "stopped": "a run is going"}
        try:
            return _reword_locked(claude, budget, cdir, result, every, apply, sheet, limit)
        finally:
            os.close(lock)
    except Exception:   # noqa: BLE001
        result["cost"] = round(result["cost"], 6)
        return {**result, "stopped": "the step failed"}


def _reword_locked(claude: str | None, budget: float, cdir: Path, result: dict, every: bool, apply: bool,
                   sheet: Path | None, limit: int) -> dict:
    def finish(**changes) -> dict:
        result.update(changes)
        result["cost"] = round(result["cost"], 6)
        return result

    try:
        _data, projects, gfolder, _names = _fill_world()
    except ValueError:
        return finish(stopped="the registry is unreadable")
    state = _reword_state(cdir)
    candidates = corroborate.reword_candidates(projects, gfolder, datetime.date.today(), state, every=every)
    if every:
        candidates = candidates[:max(limit, 0)]
    result["asked"] = len(candidates)
    if not candidates:
        return finish()
    where = {i: p for i, p, _m in corroborate.fill_records(projects, gfolder)}
    by_id = dict(candidates)
    keys = {i: corroborate.reword_key(where[i], m.handle) for i, m in candidates}
    fingerprint = hashlib.sha256(json.dumps(sorted(
        (keys[i], records.version_list(m)[-1][0].isoformat()) for i, m in candidates)).encode()).hexdigest()
    failures = state["failures"]
    if failures["fingerprint"] != fingerprint:
        failures["count"] = 0

    def save_state() -> None:
        if apply:
            au.write_json(cdir / REWORD_ATTEMPTS_NAME, state)

    if failures["count"] >= corroborate.FILL_FAILURES:
        return finish(stopped="waiting for the lessons to change", asked=0)
    if not claude:
        return finish(stopped="no claude binary")

    def failed_session(why: str) -> dict:
        failures["count"] += 1
        failures["fingerprint"] = fingerprint
        save_state()
        return finish(stopped=why)

    scratch = Path(tempfile.mkdtemp(prefix="mem-corroborate-reword-"))
    reasons: dict[str, str] = {}
    try:
        write_private(scratch / "settings.json", json.dumps({"disableAllHooks": True}))
        payload, cost, ok = _ask(claude, scratch, "write", PROPOSE_MODEL, budget, REWORD_BRIEF,
                                 corroborate.reword_blocks(candidates), "lessons", REWORD_WRITER_OUT)
        result["cost"] += cost
        try:
            proposed = corroborate.validate_reword(payload, candidates) if ok else None
        except ValueError:
            proposed = None
        if proposed is None:
            return failed_session("the writer session gave no usable answer")
        kept, _refused = corroborate.reword_survivors(proposed, candidates)
        accepted: set[str] = set()
        if kept:
            text = corroborate.check_lines([(i, m.claim, m.context, short) for i, m, short in kept])
            payload, cost, ok = _ask(claude, scratch, "check", CHECK_MODEL, budget, CHECK_BRIEF, text, "pairs",
                                     REWORD_CHECK_OUT)
            result["cost"] += cost
            checked = corroborate.validate_check(payload, [i for i, _m, _s in kept]) if ok else None
            if checked is None:
                return failed_session("the checker session gave no usable answer")
            accepted = {i for i, faithful in checked.items() if faithful}
            reasons = {v["id"]: v["reason"] for v in payload["verdicts"]
                       if isinstance(v, dict) and isinstance(v.get("id"), str) and isinstance(v.get("reason"), str)}
    finally:
        shutil.rmtree(scratch, ignore_errors=True)

    outcome = corroborate.reword_outcome(candidates, proposed, accepted)
    if apply:
        run = None
        applier = None
        for i, m in candidates:
            if outcome[i] != "written":
                continue
            if applier is None:
                run = _reword_run_folder(cdir)
                au.private_dir(run)
                write_private(run / "fill", "")   # marks the run: its undo leaves the pass's `seen.json` alone
                applier = Applier(Journal(run), {}, gfolder, run, lambda _text: None)
            if not _reword_edit(applier, where[i], m, f"--short={proposed[i]['short']}", "--reworded"):
                outcome[i] = "refused_code"
        new_state, giveup = corroborate.reword_state_after(state, candidates, outcome, datetime.date.today())
        state["lessons"] = new_state["lessons"]
        failures["count"], failures["fingerprint"] = 0, None
        save_state()
        for i in giveup:
            if applier is None:
                run = _reword_run_folder(cdir)
                au.private_dir(run)
                write_private(run / "fill", "")
                applier = Applier(Journal(run), {}, gfolder, run, lambda _text: None)
            if _reword_edit(applier, where[i], by_id[i], "--reword-failed"):
                result["gave_up"] += 1
    for word in ("refused_code", "refused_check", "same_text", "no_proposal"):
        result[word] = sum(1 for v in outcome.values() if v == word)
    result["written"] = sum(1 for v in outcome.values() if v == "written") if apply else 0
    if sheet is not None:
        _reword_sheet(sheet, [(i, m.claim, m.short, proposed.get(i, {}).get("short"),
                               "would be written" if outcome[i] == "written" and not apply else outcome[i], reasons.get(i))
                              for i, m in candidates])
    return finish()


def cmd_fill(args) -> int:
    if IMPORT_ERROR is not None:
        print(f"mem-corroborate: cannot load the engine: {IMPORT_ERROR}", file=sys.stderr)
        return 1
    usage = "usage: mem-corroborate fill --dry-run --out FILE [--claude PATH] [--budget USD] | fill --items FILE"
    if args.items:
        if args.dry_run or args.out:
            print(f"mem-corroborate: --items applies a file and goes with neither --dry-run nor --out\n{usage}", file=sys.stderr)
            return 2
        return fill_items(args)
    if not (args.dry_run and args.out):
        print(f"mem-corroborate: fill writes nothing unread: it needs --dry-run --out FILE or --items FILE\n{usage}",
              file=sys.stderr)
        return 2
    return fill_dry_run(args)


def cmd_reword(args) -> int:
    if IMPORT_ERROR is not None:
        print(f"mem-corroborate: cannot load the engine: {IMPORT_ERROR}", file=sys.stderr)
        return 1
    result = reword_auto(args.claude, args.budget, every=args.every, apply=not args.dry_run,
                         sheet=Path(args.sheet).expanduser() if args.sheet else None, limit=args.limit)
    print(json.dumps(result))
    return 1 if result["stopped"] else 0


def cmd_auto(args) -> int:
    """The whole of `auto`; never raises and never prints."""
    try:
        if os.environ.get(cs.OPTION) != "true":
            return 0
        budget = budget_of(os.environ.get(cs.BUDGET_OPTION))
    except BaseException:   # noqa: BLE001
        return 0
    try:
        execute(args.claude, budget)
    except BaseException:   # noqa: BLE001
        pass
    try:
        if (os.environ.get("CLAUDE_PLUGIN_OPTION_LOADED_RULES") != "false"
                and os.environ.get("MEM_LOADED_RULES") != "off"):
            began = time.time()
            stamp = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
            result = fill_auto(args.claude, budget)
            append_log(corroborate_dir(data_dir()), {"t": stamp, "fill": result, "ms": int((time.time() - began) * 1000)})
    except BaseException:   # noqa: BLE001
        pass
    return 0


def cmd_undo(args) -> int:
    if not STAMP_RE.fullmatch(args.stamp) or args.stamp in (".", ".."):
        print("mem-corroborate: not a run stamp", file=sys.stderr)
        return 2
    cdir = corroborate_dir(data_dir())
    run = cdir / "runs" / args.stamp
    if not run.is_dir():
        print(f"mem-corroborate: no run {args.stamp}", file=sys.stderr)
        return 2
    lock = au.take_run_lock(cdir)
    if lock is None:
        print("mem-corroborate: a run is going: try again later", file=sys.stderr)
        return 1
    try:
        if (run / "undone").exists():
            done, message = True, f"run {args.stamp} was already undone"
        else:
            done, message = undo_run(run)
            if done and not (run / "fill").exists():   # a fill run never touched the pass's `seen.json`
                forget_run(cdir, run)
    finally:
        os.close(lock)
    print(f"mem-corroborate: {message}", file=sys.stdout if done else sys.stderr)
    return 0 if done else 1


def cmd_status() -> int:
    data = au.read_json(corroborate_dir(data_dir()) / au.STATUS_NAME)
    if not data:
        print("no corroboration run yet")
        return 0
    shown = data.get("state", "?")
    started = data.get("started")
    if shown == "running" and isinstance(started, (int, float)) and time.time() - started > au.STALE_RUNNING_SECONDS:
        shown = "failed (a run that did not finish)"
    print(f"last run: state {shown}, cost {float(data.get('cost') or 0):.3f} USD")
    failure = au.failure(data, time.time())
    if failure:
        print(f"unacknowledged failure: {failure.get('reason')} (mem-corroborate ack clears it)")
    fill = data.get("fill")
    if isinstance(fill, dict) and (fill.get("written") or fill.get("refused_code") or fill.get("refused_check")
                                   or fill.get("to_triage") or fill.get("stopped")):
        refused = (fill.get("refused_code") or 0) + (fill.get("refused_check") or 0)
        stopped = f", stopped: {fill['stopped']}" if fill.get("stopped") else ""
        print(f"last fill: {fill.get('written') or 0} written, {refused} refused, {fill.get('to_triage') or 0} to triage{stopped}")
    print(f"log: {data.get('log') or '(none)'}")
    return 0


def cmd_ack() -> int:
    cdir = corroborate_dir(data_dir())
    current = au.read_json(cdir / au.STATUS_NAME)
    if current:
        changes: dict = {"failure": None}
        started = current.get("started")
        if (current.get("state") == "running" and isinstance(started, (int, float))
                and time.time() - started > au.STALE_RUNNING_SECONDS):
            changes["state"] = "failed"
        save_status(cdir, **changes)
    print("acknowledged: the failure line is cleared")
    return 0


def self_check() -> int:
    """No model: the briefs, the tool list, the gate of `auto`, the lock and the folder mode, the journal and undo."""
    assert budget_of("x") == DEFAULT_BUDGET and budget_of("0.6") == 0.6 and budget_of("0") == DEFAULT_BUDGET
    PROPOSE_BRIEF.format(lessons="a", out="b")
    VERIFY_BRIEF.format(groups="a", out="b")
    FILL_BRIEF.format(lessons="a", out="b")
    REWORD_BRIEF.format(lessons="a", out="b")
    with tempfile.TemporaryDirectory(prefix="mem-corroborate-check-") as tmp:
        tmp = Path(tmp)
        os.environ.pop(cs.OPTION, None)
        os.environ["MEM_DATA"] = str(tmp / "data")
        cmd_auto(argparse.Namespace(claude="/nonexistent"))
        assert not corroborate_dir(tmp / "data").exists(), "auto ran without the option"
        cdir = corroborate_dir(tmp / "data")
        held = au.take_run_lock(cdir)
        assert held is not None and au.take_run_lock(cdir) is None
        assert (cdir.stat().st_mode & 0o777) == 0o700, oct(cdir.stat().st_mode)
        os.close(held)
        cmd = session_cmd("claude", tmp / "w", "brief", tmp / "s.json", "haiku", 0.25)
        allowed = cmd[cmd.index("--allowedTools") + 1:cmd.index("--disallowedTools")]
        assert not any(t.startswith("Bash") for t in allowed) and "Bash" in cmd[cmd.index("--disallowedTools") + 1:]
        assert all(t.startswith(("Read(", "Write(", "Edit(")) and f"{tmp}/w" in t for t in allowed), allowed
        run = cdir / "runs" / "x"
        au.private_dir(run)
        a, b = tmp / "a.md", tmp / "b.md"
        a.write_text("one")
        journal = Journal(run)
        watched = journal.watch([a, b])
        a.write_text("two")
        b.write_text("new")
        journal.commit("check", watched)
        assert undo_run(run)[0] and a.read_text() == "one" and not b.exists()
        a.write_text("two")
        run2 = cdir / "runs" / "y"
        au.private_dir(run2)
        journal = Journal(run2)
        watched = journal.watch([a])
        a.write_text("three")
        journal.commit("check", watched)
        a.write_text("edited")
        assert not undo_run(run2)[0] and a.read_text() == "edited", "undo ran over an edited file"
    print("self-check passed")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--self-check", action="store_true", help="no model: prove the briefs, gates, lock and undo")
    commands = parser.add_subparsers(dest="command")
    default_claude = os.environ.get("CLAUDE_CODE_EXECPATH") or shutil.which("claude")
    run = commands.add_parser("run", help="match the lessons by meaning and apply the verified groups")
    run.add_argument("--claude", default=default_claude)
    run.add_argument("--budget", type=budget_of, default=DEFAULT_BUDGET, help=f"USD per session (default {DEFAULT_BUDGET})")
    run.add_argument("--dry-run", action="store_true", help="run both sessions; write the plan to --out and change nothing else")
    run.add_argument("--out", help="with --dry-run: the file for the proposal, the verdicts and the planned actions")
    run.add_argument("--groups", help="apply a reviewed file in the model's format; starts no model session")
    run.set_defaults(func=cmd_run)
    fill = commands.add_parser("fill", help="propose the short form and topic of lessons for the owner to read, or apply that file")
    fill.add_argument("--claude", default=default_claude)
    fill.add_argument("--budget", type=budget_of, default=DEFAULT_BUDGET, help=f"USD for the session (default {DEFAULT_BUDGET})")
    fill.add_argument("--dry-run", action="store_true", help="one session; write the proposal to --out and change no record")
    fill.add_argument("--out", help="with --dry-run: the file for the proposal")
    fill.add_argument("--items", help="apply a proposal file, as read and edited by the owner; starts no model session")
    fill.set_defaults(func=cmd_fill)
    reword = commands.add_parser("reword", help="write a new short form for loaded lessons that got worse, as the pass does")
    reword.add_argument("--claude", default=default_claude)
    reword.add_argument("--budget", type=budget_of, default=DEFAULT_BUDGET, help=f"USD per session (default {DEFAULT_BUDGET})")
    reword.add_argument("--every", action="store_true", help="take loaded lessons that did not get worse too")
    reword.add_argument("--limit", type=int, default=30, help="with --every: at most this many lessons (default 30)")
    reword.add_argument("--dry-run", action="store_true", help="run both sessions; change no record and save no state")
    reword.add_argument("--sheet", help="write a Markdown table of every candidate and its outcome to this file")
    reword.set_defaults(func=cmd_reword)
    auto = commands.add_parser("auto", help="what a hook starts: one run when the option is on; silent")
    auto.add_argument("--claude", default=default_claude)
    auto.set_defaults(func=cmd_auto)
    undo = commands.add_parser("undo", help="put back the files a run changed")
    undo.add_argument("stamp")
    undo.set_defaults(func=cmd_undo)
    commands.add_parser("status", help="the last run").set_defaults(func=lambda _a: cmd_status())
    commands.add_parser("ack", help="clear the failure line").set_defaults(func=lambda _a: cmd_ack())
    args = parser.parse_args()
    if args.self_check:
        return self_check()
    if not args.command:
        parser.error("a command is required")
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
