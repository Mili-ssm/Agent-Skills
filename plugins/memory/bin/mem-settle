#!/usr/bin/env python3
"""mem-settle: one bounded settling run in the background (plan 2026-11-17-memory-seamless, stage W).

`run` (detached, no output): takes the run lock first and exits quietly when it is busy; asks `mem settle due` whether
new global memories wait and the last apply ended more than `--minutes` ago (a failed run also waits that long before
the next); `mem settle pending --json` writes the look-alike pairs to a work folder; with none the run ends (no
session). Otherwise ONE headless Haiku session reads the pairs file and writes `verdicts.json`: it has no Bash, so it
cannot call `mem` itself, and Python applies the file with `mem settle apply`, which enforces what may change. A session
that fails, ends without a cost report, or leaves no valid verdict list changes nothing and is recorded as a failure,
shown by the next session start text until `mem-settle ack`. State, logs and transcripts: `<state folder>/settle/<id>/`
(mode 0700, runs kept 30 days). It never reads or writes the `mem-auto` status.

Usage: mem-settle run [--store PATH] [--claude PATH] [--budget USD] [--minutes M] | status | ack | --self-check
       mem-settle run --dry-run   (says whether it would start; starts nothing and changes nothing)
"""
from __future__ import annotations

import argparse
import fcntl
import importlib.machinery
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "engine"))
import auto_state as au  # noqa: E402
import settle_state as ss  # noqa: E402
import synth_pipeline as sp  # noqa: E402

_loader = importlib.machinery.SourceFileLoader("mem_synthesize", str(HERE / "mem-synthesize"))
ms = importlib.util.module_from_spec(importlib.util.spec_from_loader("mem_synthesize", _loader))
_loader.exec_module(ms)

DEFAULT_BUDGET = 0.25   # USD per run
KEEP_SECONDS = 30 * 86400
SESSION_TIMEOUT = 600
FAILURE_WAIT = 30      # minutes a failed run waits at least, also at session end (which asks with 0 minutes)
SESSION_VARS = ("CLAUDE_ENV_FILE", "CLAUDE_PLUGIN_ROOT", "CLAUDE_PLUGIN_DATA", "CLAUDE_PROJECT_DIR", "CLAUDE_PID",
                "CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN")


def budget_of(value: str | float | None) -> float:
    try:
        number = float(value)
    except (TypeError, ValueError):
        return DEFAULT_BUDGET
    return number if number > 0 else DEFAULT_BUDGET


def stamp(seconds: float | None) -> str:
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(seconds)) if seconds else "never"


class State:
    """The files of one store's settling runs."""

    def __init__(self, store: Path):
        self.store = store
        self.dir = ss.settle_dir(ms.state_dir(), store)

    def status(self) -> dict:
        return au.read_json(self.dir / au.STATUS_NAME)

    def save_status(self, **changes) -> dict:
        au.private_dir(self.dir)
        data = {**self.status(), **changes}
        au.write_json(self.dir / au.STATUS_NAME, data)
        return data


def run_env(store: Path) -> dict:
    """The `mem` calls and the session: aimed at `store`; a configured memories folder is kept."""
    env = ms.session_env(store)
    if os.environ.get("MEM_MEMORIES"):
        env["MEM_MEMORIES"] = os.environ["MEM_MEMORIES"]
    return env


def prune(state: State, now: float) -> None:
    runs = state.dir / "runs"
    if not runs.is_dir():
        return
    for folder in runs.iterdir():
        try:
            if now - folder.stat().st_mtime > KEEP_SECONDS:
                shutil.rmtree(folder, ignore_errors=True)
        except OSError:
            continue


def session_cmd(claude: str, work: Path, brief: str, settings: Path, max_budget: float) -> list[str]:
    """One Haiku session. Tools: Read and Write/Edit inside `work` only; no Bash (a session with `Bash(mem *)` could
    run any `mem` command and bypass the limits `mem settle apply` enforces), no web, hooks disabled by `settings`."""
    return [claude, "-p", brief, "--model", "haiku", "--effort", "medium", "--settings", str(settings),
           "--setting-sources", "project",
           "--allowedTools", f"Read(/{work}/**)", f"Write(/{work}/**)", f"Edit(/{work}/**)",   # `//` is an absolute path
           "--disallowedTools", "Bash", "WebSearch", "WebFetch",
           "--output-format", "stream-json", "--verbose", "--no-session-persistence",
           "--max-budget-usd", f"{max_budget:.4f}"]


def session(claude: str, work: Path, brief: str, settings: Path, env: dict, log: Path, max_budget: float) -> dict:
    cmd = session_cmd(claude, work, brief, settings, max_budget)
    start = time.monotonic()
    try:
        done = subprocess.run(cmd, cwd=work, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                              timeout=SESSION_TIMEOUT)
        raw = done.stdout
    except subprocess.TimeoutExpired as exc:
        raw = exc.stdout.decode() if isinstance(exc.stdout, bytes) else (exc.stdout or "")
    log.write_text(raw)
    result = sp.parse(raw)
    result["wall"] = time.monotonic() - start
    return result


def read_verdicts(path: Path) -> str | None:
    """None when `path` holds a JSON list; else why not."""
    if not path.is_file():
        return "the session wrote no verdicts file"
    try:
        rows = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return "the verdicts file is not valid JSON"
    return None if isinstance(rows, list) else "the verdicts file is not a JSON list"


def work_steps(state: State, claude: str | None, budget: float, root: Path, log, acct: dict) -> None:
    """Pairs, the session, the apply. `acct` (`cost`, `failures`, `summary`) is filled as it goes, so an exception later
    still leaves what was spent."""
    env = run_env(state.store)
    work = root / "work"
    work.mkdir(mode=0o700)
    found = sp.mem(state.store, env, "settle", "pending", "--json")
    if found.returncode:
        acct["failures"].append(f"mem settle pending failed: {(found.stderr or found.stdout).strip()[:150]}")
        return
    try:
        pairs = json.loads(found.stdout)
    except ValueError:
        pairs = None
    if not isinstance(pairs, list):
        acct["failures"].append("mem settle pending gave no JSON list")
        return
    log(f"pairs: {len(pairs)}")
    acct["pairs"] = len(pairs)
    if not pairs:   # `pending` already judged the handles it looked at: nothing to ask a model
        return
    if not claude:
        acct["failures"].append("no claude binary (--claude, CLAUDE_CODE_EXECPATH or PATH)")
        return
    pairs_file, verdicts_file = work / "pairs.json", work / "verdicts.json"
    pairs_file.write_text(json.dumps(pairs, ensure_ascii=False, indent=1), encoding="utf-8")
    settings = root / "settings.json"
    settings.write_text(json.dumps({"disableAllHooks": True}))   # no hook of the session may commit or start a run
    brief = sp.brief("settle", PAIRS_FILE=str(pairs_file), VERDICTS_FILE=str(verdicts_file))
    done = session(claude, work, brief, settings, env, root / "session.jsonl", budget)
    acct["cost"] += done["cost"]
    log(f"session: has_result={done['has_result']} error={done['error']} cost={done['cost']:.3f} "
        f"answer={' '.join(done['answer'].split())[:200]}")
    if not done["has_result"]:
        acct["failures"].append(sp.NO_COST)
        return
    if done["error"]:
        acct["failures"].append("settling session failed")
        return
    why = read_verdicts(verdicts_file)
    if why:
        acct["failures"].append(why)
        return
    applied = sp.mem(state.store, env, "settle", "apply", "--verdicts", str(verdicts_file))
    log(f"apply: exit {applied.returncode}\n{applied.stdout.strip()}\n{applied.stderr.strip()}")
    if applied.returncode:
        acct["failures"].append(f"mem settle apply failed: {(applied.stderr or applied.stdout).strip()[:150]}")
        return
    lines = applied.stdout.splitlines()
    acct["summary"] = ", ".join(f"{n} {word}" for word in ("applied", "refused", "failed")
                                if (n := sum(1 for ln in lines if ln.startswith(word + "\t"))))
    if any(ln.startswith("failed\t") for ln in lines):
        acct["failures"].append("a settling was only partly done: see the log")


def due_check(store: Path, minutes: float) -> tuple[bool, str]:
    """(due, why not or the error): `mem settle due` exits 0 when work waits, 1 when none."""
    done = sp.mem(store, run_env(store), "settle", "due", "--minutes", str(minutes))
    if done.returncode == 0:
        return True, done.stdout.strip()
    if done.returncode == 1:
        return False, "no new memories wait, or the last apply is recent"
    return False, f"mem settle due failed: {(done.stderr or done.stdout).strip()[:150]}"


def cmd_run(store: Path, claude: str | None, budget_arg: str | float | None, minutes_arg: str | float | None) -> int:
    state = State(store)
    fd = au.take_run_lock(state.dir)   # the first action: a busy lock means a run is going
    if fd is None:
        return 0
    now = time.time()
    minutes = ss.minutes_of(minutes_arg)
    log_file = None
    acct: dict = {"cost": 0.0, "failures": [], "pairs": 0, "summary": ""}

    def finish() -> None:
        """The end status, written while the lock is still held."""
        failures = acct["failures"]
        finished = time.time()
        reason = "; ".join(failures)
        if log_file is None:   # nothing started (not due, or the check failed)
            if failures:
                state.save_status(failure={"at": finished, "reason": reason, "log": ""})
            return
        state.save_status(state="failed" if failures else "ok", finished=finished, cost=acct["cost"], reason=reason,
                          pairs=acct["pairs"], summary=acct["summary"],
                          **({"failure": {"at": finished, "reason": reason, "log": str(log_file)}} if failures else {}))

    try:
        previous = state.status()
        # a failed run is not retried at once: its pairs stay pending, and every write would start it again
        if previous.get("state") == "failed" and now - float(previous.get("finished") or 0) <= max(minutes, FAILURE_WAIT) * 60:
            return 0
        budget = budget_of(budget_arg)
        due, why = due_check(store, minutes)
        if not due:
            if why.startswith("mem settle due failed"):
                acct["failures"].append(why)
                finish()
            return 0
        stale = au.failure({"state": previous.get("state"), "started": previous.get("started"),
                            "log": previous.get("log")}, now)
        root = state.dir / "runs" / f"{time.strftime('%Y%m%d-%H%M%S')}-{os.getpid()}"
        au.private_dir(root)
        prune(state, now)
        log_file = root / "log.txt"

        def log(text: str) -> None:
            fd_log = os.open(log_file, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd_log, "a") as f:
                f.write(f"{time.strftime('%H:%M:%S')} {text}\n")

        extra = {"failure": stale} if stale and not previous.get("failure") else {}
        state.save_status(state="running", started=now, finished=None, cost=0.0, reason="", log=str(log_file), **extra)
        log(f"start: budget {budget:.2f}")
        work_steps(state, claude, budget, root, log, acct)
        if acct["cost"] > budget + 1e-9:
            acct["failures"].append(f"cost {acct['cost']:.2f} USD is over the budget {budget:.2f}")
        finish()
    except Exception as exc:   # anything after the lock ends as a `failed` status; a killed run is the stale case
        acct["failures"].append(f"{type(exc).__name__}: {exc}"[:150])
        try:
            finish()
        except Exception:
            pass
    finally:
        os.close(fd)
    return 0


def cmd_dry_run(store: Path, claude: str | None, budget_arg, minutes_arg) -> int:
    minutes = ss.minutes_of(minutes_arg)
    state = State(store)
    previous = state.status()
    due, why = due_check(store, minutes)
    reason = ("a settling run holds the lock" if _lock_held(state)
              else "the last run failed less than the minutes ago" if previous.get("state") == "failed"
              and time.time() - float(previous.get("finished") or 0) <= minutes * 60
              else "" if due else why)
    print(f"minutes: {minutes}; budget: {budget_of(budget_arg):.2f} USD; claude: {claude or '(none)'}; "
          + (f"would not start: {reason}" if reason else "would start"))
    return 0


def _lock_held(state: State) -> bool:
    """Reads only: no folder is made; any doubt answers False."""
    try:
        fd = os.open(state.dir / au.LOCK_NAME, os.O_RDWR)
    except OSError:
        return False
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return True
    except OSError:
        return False
    finally:
        os.close(fd)
    return False


def cmd_status(store: Path) -> int:
    data = State(store).status()
    if not data:
        print("no settling run yet")
        return 0
    now = time.time()
    shown = data.get("state", "?")
    if shown == "running" and now - float(data.get("started") or 0) > au.STALE_RUNNING_SECONDS:
        shown = "failed (a run that did not finish)"
    print(f"last run: {stamp(data.get('started'))}, state {shown}, cost {float(data.get('cost') or 0):.3f} USD, "
          f"pairs {data.get('pairs', 0)}")
    if data.get("summary"):
        print(f"applied: {data['summary']}")
    if data.get("reason"):
        print(f"reason: {data['reason']}")
    print(f"log: {data.get('log') or '(none)'}")
    print(f"unacknowledged failure: {'yes (mem-settle ack clears it)' if au.failure(data, now) else 'no'}")
    return 0


def cmd_ack(store: Path) -> int:
    state = State(store)
    data = state.status()
    if data:
        changes: dict = {"failure": None}
        if au.failure({"state": data.get("state"), "started": data.get("started")}, time.time()):
            changes["state"] = "failed"   # a stale `running` is closed
        state.save_status(**changes)
    print("acknowledged: the failure line is cleared")
    return 0


def self_check() -> int:
    """No model: the lock, the folder mode, the options, a run with nothing to settle (it starts no session) and the
    session's tool list (no Bash)."""
    assert budget_of("x") == DEFAULT_BUDGET and budget_of("0.6") == 0.6 and budget_of("0") == DEFAULT_BUDGET
    with tempfile.TemporaryDirectory(prefix="mem-settle-check-") as tmp:
        tmp = Path(tmp)
        for name, folder in (("MEM_DATA", "data"), ("XDG_DATA_HOME", "share"), ("MEM_PROJECT", "project"),
                             ("XDG_CONFIG_HOME", "cfg")):
            os.environ[name] = str(tmp / folder)
        os.environ.pop("MEM_MEMORIES", None)
        store = tmp / "store"
        init = subprocess.run([str(sp.MEM), "init", str(store)], capture_output=True, text=True)
        assert init.returncode == 0, init.stderr
        state = State(store)
        held = au.take_run_lock(state.dir)
        assert held is not None and au.take_run_lock(state.dir) is None
        assert cmd_run(store, "/nonexistent", None, 0) == 0 and not state.status().get("state"), "ran while locked"
        os.close(held)
        assert (state.dir.stat().st_mode & 0o777) == 0o700, oct(state.dir.stat().st_mode)
        assert cmd_run(store, "/nonexistent", None, 0) == 0 and not state.status().get("state"), "ran with nothing new"
        (store / "memories").mkdir(exist_ok=True)
        found = sp.mem(store, dict(os.environ), "settle", "log")
        assert found.returncode == 0, found.stderr
        cmd = session_cmd("claude", tmp / "w", "brief", tmp / "s.json", 0.25)
        allowed = cmd[cmd.index("--allowedTools") + 1:cmd.index("--disallowedTools")]
        assert not any(t.startswith("Bash") for t in allowed) and "Bash" in cmd[cmd.index("--disallowedTools") + 1:]
        assert all(t.startswith(("Read(", "Write(", "Edit(")) and f"{tmp}/w" in t for t in allowed), allowed
    print("self-check passed")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("command", nargs="?", choices=["run", "status", "ack"])
    parser.add_argument("--store", type=Path, help="default: the store `mem` resolves (MEM_STORE, else the default)")
    parser.add_argument("--claude", default=os.environ.get("CLAUDE_CODE_EXECPATH") or shutil.which("claude"))
    parser.add_argument("--budget", help=f"USD per run (default {DEFAULT_BUDGET})")
    parser.add_argument("--minutes", help=f"a run starts only when the last apply ended more than this long ago "
                                          f"(default {ss.DEFAULT_MINUTES:.0f}; 0 at the end of a session)")
    parser.add_argument("--dry-run", action="store_true", help="say whether `run` would start; change nothing")
    parser.add_argument("--self-check", action="store_true", help="no model: prove the lock, the gates and the tool list")
    args = parser.parse_args()
    if args.self_check:
        return self_check()
    if not args.command:
        parser.error("a command is required")
    store = args.store.expanduser().resolve() if args.store else ms.default_store()
    if store is None or not (store / "mem-store.yaml").is_file():
        if args.command != "run":   # run is silent: it starts from a hook
            print(f"mem-settle: no store at {store}", file=sys.stderr)
        return 0 if args.command == "run" else 2
    if args.command == "run":
        if args.dry_run:
            return cmd_dry_run(store, args.claude, args.budget, args.minutes)
        for name in SESSION_VARS:   # left over from the session that started this process
            os.environ.pop(name, None)
        return cmd_run(store, args.claude, args.budget, args.minutes)
    return {"status": lambda: cmd_status(store), "ack": lambda: cmd_ack(store)}[args.command]()


if __name__ == "__main__":
    sys.exit(main())
