{
  "description": "Opens sessions and subagents with the memory text; captures and commits the store at session end and before compaction",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEM_HOST=codex \"${PLUGIN_ROOT}\"/hooks/session-index.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "MEM_HOST=codex \"${PLUGIN_ROOT}\"/hooks/offload-policy.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEM_HOST=codex \"${PLUGIN_ROOT}\"/hooks/subagent-start.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEM_HOST=codex \"${PLUGIN_ROOT}\"/hooks/session-end.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MEM_HOST=codex \"${PLUGIN_ROOT}\"/hooks/pre-compact.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
